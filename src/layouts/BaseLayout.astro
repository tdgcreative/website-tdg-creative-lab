---
import BaseHead, { type ArticleMeta } from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath?: string;
  alternateIdPath?: string;
  alternateEnPath?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  articleMeta?: ArticleMeta;
}

const { 
  title, 
  description, 
  ogImage,
  canonicalPath, 
  alternateIdPath,
  alternateEnPath,
  noindex,
  ogType,
  articleMeta
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead 
      title={title} 
      description={description} 
      ogImage={ogImage}
      canonicalPath={canonicalPath} 
      alternateIdPath={alternateIdPath}
      alternateEnPath={alternateEnPath}
      noindex={noindex}
      ogType={ogType}
      articleMeta={articleMeta}
    />
  </head>
  <body class="flex flex-col min-h-screen bg-brand-bg text-brand-dark selection:bg-brand-orange selection:text-white font-sans antialiased overflow-x-hidden">
    <Navbar alternateIdPath={alternateIdPath} alternateEnPath={alternateEnPath} />
    
    <main class="flex-grow pt-20 md:pt-24">
      <slot />
    </main>

    <Footer />
  </body>
</html>
