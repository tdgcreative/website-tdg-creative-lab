  },
  {
    title: "D'Regentist",
    category: "Visual Production & Documentation",
    tags: ["Profile Photoshoot", "Architectural Doc"],
    imageSrc: regentistImg,
    svgIcon: "dental",
    filterClass: "visual-doc",
    scopes: "Profile Photoshoot, Architectural Photoshoot",
    year: "2023",
    description: "Sesi foto profil tim arsitektur dan dokumentasi visual tata ruang yang menangkap detail estetika ruangan, kenyamanan tata cahaya, serta kemewahan rancangan modern yang khas.",
