    description: "Kampanye video produk material PVC board premium. Kami memvisualisasikan daya tahan produk, kemudahan pemasangan, serta contoh pengaplikasian panel kayu modern dalam tata ruang interior minimalis yang estetik.",
    outputs: [
      { id: "btc1", title: "Product Showcase Video", type: "video", src: "/videos/btc-board.mp4" },
      { id: "btc2", title: "Material Application Shoot", type: "image", src: btcBoardImg.src },
    ]
  },
  {
    title: "SETASE",
    category: "Visual Production & Documentation",
    tags: ["Lookbook Photoshoot", "Studio Styling"],
    imageSrc: setaseImg,
    svgIcon: "fashion",
    filterClass: "visual-doc",
    scopes: "Lookbook Photoshoot, Studio Styling, Art Direction",
    year: "2024",
    description: "Produksi visual lookbook pakaian fashion pria/wanita dengan pengarahan gaya studio yang bersih, minimalis, dan elegan untuk menonjolkan detail serta kualitas bahan produk premium.",
    outputs: [
      { id: "st1", title: "Studio Lookbook Shoot", type: "image", src: setaseImg.src },
