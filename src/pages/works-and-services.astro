---

<BaseLayout title={title} description={description} canonicalPath="/works-and-services">
  <!-- Page Header -->
  <section class="py-12 sm:py-16 md:py-24 border-b border-brand-dark/5 relative bg-white">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.015)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.015)_1px,transparent_1px)] bg-[size:3rem_3rem] pointer-events-none" />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10 flex flex-col gap-2 sm:gap-4">
      <span class="text-brand-orange font-bold tracking-widest text-[10px] sm:text-xs uppercase">Portfolio & Capabilities</span>
      <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black uppercase tracking-tight text-brand-dark leading-tight">
        {t('works.title')}
      </h1>
    </div>
  </section>

  <!-- Interactive Portfolio Grid Section -->
  <section class="py-12 sm:py-16 md:py-24" id="portfolio-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      
      <!-- Interactive Filter Tabs (3 Scopes Ecosystem) -->
      <div class="flex flex-wrap gap-2 sm:gap-3 mb-8 sm:mb-12 justify-center md:justify-start" role="group" aria-label="Project filter">
        <button 
          class="filter-btn px-4 sm:px-6 py-2.5 sm:py-3 rounded-full text-[11px] sm:text-xs font-bold border border-brand-dark/10 bg-brand-dark text-white transition-all duration-300 cursor-pointer shadow-sm"
          data-filter="all"
        >
          {t('portfolio.filter.all')}
        </button>
        <button 
          class="filter-btn px-4 sm:px-6 py-2.5 sm:py-3 rounded-full text-[11px] sm:text-xs font-bold border border-brand-dark/10 bg-white text-brand-dark hover:border-brand-orange hover:text-brand-orange transition-all duration-300 cursor-pointer shadow-sm"
          data-filter="content-media"
        >
          {t('portfolio.filter.contentMedia')}
        </button>
        <button 
          class="filter-btn px-4 sm:px-6 py-2.5 sm:py-3 rounded-full text-[11px] sm:text-xs font-bold border border-brand-dark/10 bg-white text-brand-dark hover:border-brand-orange hover:text-brand-orange transition-all duration-300 cursor-pointer shadow-sm"
          data-filter="brand-digital"
        >
          {t('portfolio.filter.brandDigital')}
        </button>
        <button 
          class="filter-btn px-4 sm:px-6 py-2.5 sm:py-3 rounded-full text-[11px] sm:text-xs font-bold border border-brand-dark/10 bg-white text-brand-dark hover:border-brand-orange hover:text-brand-orange transition-all duration-300 cursor-pointer shadow-sm"
          data-filter="visual-doc"
        >
          {t('portfolio.filter.visualDoc')}
        </button>
      </div>

      <!-- Portfolio Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 animate-fade-in" id="portfolio-grid">
        {portfolios.map((portfolio) => (
          <div 
            class="portfolio-item-wrap cursor-pointer" 
            data-category={portfolio.filterClass}
            data-category-name={portfolio.category}
            data-title={portfolio.title}
            data-year={portfolio.year}
            data-scopes={portfolio.scopes}
            data-desc={portfolio.description}
            data-outputs={JSON.stringify(portfolio.outputs)}
          >
            <PortfolioCard 
              title={portfolio.title}
              category={portfolio.category}
              tags={portfolio.tags}
              imageSrc={portfolio.imageSrc}
              svgIcon={portfolio.svgIcon}
              imagePosition={portfolio.imagePosition}
              imageFit={portfolio.imageFit}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Case Study Modal (Multi-Deliverables & Anti-Cropping) -->
  <div 
    id="portfolio-modal" 
    class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 md:p-6 bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
  >
    <div class="bg-brand-bg text-brand-dark rounded-3xl sm:rounded-[2rem] shadow-2xl border border-brand-dark/10 max-w-6xl w-full max-h-[92vh] overflow-y-auto md:overflow-hidden flex flex-col md:flex-row relative transform scale-95 transition-all duration-300" id="modal-container">
      
      <!-- Close Button Top Right -->
      <button 
        id="modal-close-btn" 
        class="absolute top-3 right-3 sm:top-5 sm:right-5 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-dark/15 hover:bg-brand-dark text-brand-dark hover:text-white flex items-center justify-center transition-all cursor-pointer shadow-md"
        aria-label="Close Case Study"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Left Panel: Media Showcase Viewport (Aspect-Preserving & Uncropped) -->
      <div class="md:w-[58%] lg:w-[62%] bg-[#0e0e0e] flex flex-col justify-between relative overflow-hidden min-h-[320px] sm:min-h-[440px] md:min-h-[580px] shrink-0 border-b md:border-b-0 md:border-r border-white/10">
        
        <!-- Main Media Display (Centered, object-contain, never cut off!) -->
        <div class="flex-1 flex items-center justify-center p-4 sm:p-6 relative w-full overflow-hidden bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.04),transparent_70%)]">
          <!-- Image display -->
          <img 
            id="modal-image" 
            src="" 
            alt="Case Study Deliverable" 
            class="max-h-[42vh] sm:max-h-[52vh] md:max-h-[58vh] w-auto h-auto max-w-full object-contain rounded-xl shadow-2xl transition-all duration-300 hidden"
          />
          
          <!-- Video player -->
          <video 
            id="modal-video" 
            class="max-h-[42vh] sm:max-h-[52vh] md:max-h-[58vh] w-auto h-auto max-w-full rounded-xl shadow-2xl hidden bg-black" 
            controls 
            playsinline
          >
            Your browser does not support the video tag.
          </video>
          
          <!-- PDF Document Card -->
          <div 
            id="modal-pdf-container" 
            class="flex flex-col items-center justify-center p-6 sm:p-8 bg-white/5 border border-white/10 rounded-2xl text-white hidden text-center gap-4 max-w-md w-full my-auto"
          >
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-brand-orange/20 flex items-center justify-center text-brand-orange">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 sm:w-10 sm:h-10">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </div>
            <div>
              <h4 class="text-base sm:text-lg font-black uppercase tracking-tight text-white" id="modal-pdf-title">Dokumen Desain</h4>
              <p class="text-xs text-white/60 font-semibold mt-1">Dokumen Presentasi / Brandbook Eksklusif (PDF)</p>
            </div>
            <a 
              id="modal-pdf-btn" 
              href="" 
              target="_blank" 
              class="bg-brand-orange hover:bg-brand-orange-light text-white font-extrabold px-6 py-3 rounded-full text-xs transition-colors shadow-lg inline-flex items-center gap-2"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              <span id="modal-pdf-label">Buka / Unduh Dokumen</span>
            </a>
          </div>
        </div>

        <!-- Deliverables Outputs Navigation Bar -->
        <div class="bg-black/75 backdrop-blur-md border-t border-white/10 p-3 sm:p-4 z-10">
          <div class="flex items-center justify-between gap-3 mb-2 px-1">
            <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-white/50 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-orange"></span>
              <span>Output Pengerjaan (<span id="modal-outputs-count">1</span>)</span>
            </span>
            <span class="text-[10px] sm:text-xs text-brand-orange font-bold truncate max-w-[240px]" id="modal-active-output-title">Output 1</span>
          </div>
          <!-- Output Selector Buttons -->
          <div id="modal-outputs-bar" class="flex gap-2 overflow-x-auto pb-1 scrollbar-thin">
            <!-- Injected dynamically via JavaScript -->
          </div>
        </div>
      </div>

      <!-- Right Panel: Information Details -->
      <div class="md:w-[42%] lg:w-[38%] p-6 sm:p-8 md:p-10 overflow-y-auto flex flex-col justify-between bg-brand-bg">
        <div class="flex flex-col gap-5 sm:gap-6">
          <div>
            <span id="modal-info-category" class="text-brand-orange text-[10px] sm:text-xs font-bold tracking-widest uppercase block mb-1">Content & Media</span>
            <h2 id="modal-title" class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-brand-dark leading-tight">
              Client Name
            </h2>
          </div>

          <!-- Metadata table -->
          <div class="grid grid-cols-2 gap-3 sm:gap-4 border-y border-brand-dark/10 py-3 sm:py-4">
            <div class="flex flex-col">
              <span class="text-[10px] font-bold text-brand-dark/40 uppercase tracking-wider">{t('portfolio.modal.client')}</span>
              <span id="modal-client" class="text-xs sm:text-sm font-extrabold text-brand-dark">The Client</span>
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] font-bold text-brand-dark/40 uppercase tracking-wider">{t('portfolio.modal.year')}</span>
              <span id="modal-year" class="text-xs sm:text-sm font-extrabold text-brand-dark">2024</span>
            </div>
            <div class="col-span-2 flex flex-col gap-1.5">
              <span class="text-[10px] font-bold text-brand-dark/40 uppercase tracking-wider">{t('portfolio.modal.scopes')}</span>
              <div id="modal-scopes" class="flex flex-wrap gap-1.5">
                <!-- Chips injected here -->
              </div>
            </div>
          </div>

          <!-- Description -->
          <div class="flex flex-col gap-3 text-xs sm:text-sm font-medium text-brand-dark/75 leading-relaxed">
            <p id="modal-desc">
              Project case study details paragraph here.
            </p>
          </div>
        </div>

        <div class="mt-8 pt-5 border-t border-brand-dark/10 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <a 
            id="modal-wa-btn"
            href="https://wa.me/628138238837"
            target="_blank"
            class="bg-brand-orange hover:bg-brand-orange-light text-white font-bold px-5 py-2.5 rounded-full text-xs transition-all text-center shadow-md flex items-center justify-center gap-2"
          >
            <span>Konsultasi Serupa</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <button 
            id="modal-close-btn-bottom" 
            class="border border-brand-dark/20 hover:border-brand-dark text-brand-dark font-bold px-5 py-2.5 rounded-full text-xs transition-colors cursor-pointer text-center"
          >
            {t('portfolio.modal.close')}
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Repeated Industry Expertise -->
  <section class="py-14 sm:py-20 bg-brand-dark text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom,rgba(255,80,0,0.05),transparent_70%)] pointer-events-none" />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center flex flex-col items-center gap-6 sm:gap-8">
      <span class="text-brand-orange font-bold tracking-widest text-[10px] sm:text-xs uppercase">{t('expertise.title')}</span>
      <h2 class="text-2xl sm:text-3xl md:text-5xl font-black uppercase tracking-tight max-w-3xl leading-tight">
        Proven Across Premium Business Segments
      </h2>
      <div class="flex flex-wrap justify-center gap-2.5 sm:gap-4 max-w-4xl mt-2 sm:mt-4">
        {industries.map((ind) => (
          <div class="bg-white/5 border border-white/15 px-4 py-2.5 sm:px-6 sm:py-3.5 rounded-xl sm:rounded-2xl text-xs sm:text-sm md:text-base font-extrabold text-white tracking-tight hover:border-brand-orange hover:text-brand-orange transition-colors cursor-default">
            {ind}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Simple Consultation WhatsApp CTA Section -->
  <SimpleCTA />
</BaseLayout>

<script>
  // Filter functionality
  const buttons = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.portfolio-item-wrap');

  const setFilter = (filter: string, shouldScroll = false) => {
    // Update active button state
    buttons.forEach((b) => {
      if (b.getAttribute('data-filter') === filter) {
        b.classList.remove('bg-white', 'text-brand-dark');
        b.classList.add('bg-brand-dark', 'text-white');
      } else {
        b.classList.remove('bg-brand-dark', 'text-white');
        b.classList.add('bg-white', 'text-brand-dark');
      }
    });

    // Filter portfolio items with smooth fade effect
    items.forEach((item) => {
      const category = item.getAttribute('data-category');
      const element = item as HTMLElement;

      if (filter === 'all' || category === filter) {
        element.classList.remove('hidden');
        setTimeout(() => {
          element.style.opacity = '1';
          element.style.transform = 'scale(1)';
          element.style.transition = 'opacity 0.4s ease-out, transform 0.4s ease-out';
        }, 50);
      } else {
        element.style.opacity = '0';
        element.style.transform = 'scale(0.97)';
        element.style.transition = 'opacity 0.4s ease-out, transform 0.4s ease-out';
        
        setTimeout(() => {
          element.classList.add('hidden');
        }, 400);
      }
    });

    if (shouldScroll) {
      const section = document.getElementById('portfolio-section');
      if (section) {
        section.scrollIntoView({ behavior: 'smooth' });
      }
    }
  };

  buttons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const filter = btn.getAttribute('data-filter') || 'all';
      setFilter(filter, false);
    });
  });

  // Check URL search parameters (e.g. ?filter=content-media)
  const urlParams = new URLSearchParams(window.location.search);
  const initialFilter = urlParams.get('filter');
  if (initialFilter) {
    setFilter(initialFilter, true);
  }

  // Modal Functionality
  const modal = document.getElementById('portfolio-modal') as HTMLElement;
  const modalContainer = document.getElementById('modal-container') as HTMLElement;
  const modalImage = document.getElementById('modal-image') as HTMLImageElement;
  const modalVideo = document.getElementById('modal-video') as HTMLVideoElement;
  const modalPdfContainer = document.getElementById('modal-pdf-container') as HTMLElement;
  const modalPdfBtn = document.getElementById('modal-pdf-btn') as HTMLAnchorElement;
  const modalPdfLabel = document.getElementById('modal-pdf-label') as HTMLElement;
  const modalPdfTitle = document.getElementById('modal-pdf-title') as HTMLElement;

  const modalTitle = document.getElementById('modal-title') as HTMLElement;
  const modalInfoCategory = document.getElementById('modal-info-category') as HTMLElement;
  const modalClient = document.getElementById('modal-client') as HTMLElement;
  const modalYear = document.getElementById('modal-year') as HTMLElement;
  const modalScopes = document.getElementById('modal-scopes') as HTMLElement;
  const modalDesc = document.getElementById('modal-desc') as HTMLElement;

  const modalOutputsCount = document.getElementById('modal-outputs-count') as HTMLElement;
  const modalActiveOutputTitle = document.getElementById('modal-active-output-title') as HTMLElement;
  const modalOutputsBar = document.getElementById('modal-outputs-bar') as HTMLElement;

  interface OutputData {
    id: string;
    title: string;
    type: 'image' | 'video' | 'pdf';
    src: string;
    caption?: string;
  }

  const switchOutput = (output: OutputData, activeBtn: HTMLElement | null) => {
    modalActiveOutputTitle.textContent = output.title;

    // Highlight active button in bar
    const allTabBtns = modalOutputsBar.querySelectorAll('.output-tab-btn');
    allTabBtns.forEach((b) => {
      b.classList.remove('bg-brand-orange', 'text-white');
      b.classList.add('bg-white/10', 'text-white/80');
    });
    if (activeBtn) {
      activeBtn.classList.remove('bg-white/10', 'text-white/80');
      activeBtn.classList.add('bg-brand-orange', 'text-white');
    }

    // Reset video playback
    modalVideo.pause();
    modalVideo.classList.add('hidden');
    modalVideo.removeAttribute('src');

    // Reset image and PDF
    modalImage.classList.add('hidden');
    modalPdfContainer.classList.add('hidden');

    if (output.type === 'video') {
      modalVideo.src = output.src;
      modalVideo.load();
      modalVideo.classList.remove('hidden');
      modalVideo.play().catch(() => {});
    } else if (output.type === 'pdf') {
      modalPdfBtn.href = output.src;
      modalPdfTitle.textContent = output.title;
      modalPdfLabel.textContent = "Buka Dokumen PDF";
      modalPdfContainer.classList.remove('hidden');
    } else {
      modalImage.src = output.src;
      modalImage.alt = output.title;
      modalImage.classList.remove('hidden');
    }
  };

  items.forEach((card) => {
    card.addEventListener('click', () => {
      const title = card.getAttribute('data-title') || '';
      const categoryName = card.getAttribute('data-category-name') || '';
      const year = card.getAttribute('data-year') || '';
      const scopes = card.getAttribute('data-scopes') || '';
      const desc = card.getAttribute('data-desc') || '';
      const rawOutputs = card.getAttribute('data-outputs') || '[]';

      let outputs: OutputData[] = [];
      try {
        outputs = JSON.parse(rawOutputs);
      } catch (e) {
        outputs = [];
      }

      // Populate text
      modalTitle.textContent = title;
      modalClient.textContent = title;
      modalInfoCategory.textContent = categoryName;
      modalYear.textContent = year;
      modalDesc.textContent = desc;

      // Render scopes as chips
      modalScopes.innerHTML = '';
      scopes.split(',').forEach((s) => {
        const span = document.createElement('span');
        span.className = 'bg-brand-dark/5 px-3 py-1 rounded-full text-[10px] font-bold text-brand-dark/75';
        span.textContent = s.trim();
        modalScopes.appendChild(span);
      });

      // Build outputs bar
      modalOutputsCount.textContent = outputs.length.toString();
      modalOutputsBar.innerHTML = '';

      if (outputs.length === 0) {
        // Fallback to card image
        const img = card.querySelector('img');
        const fallbackSrc = img ? img.getAttribute('src') || '' : '';
        outputs = [{ id: 'f1', title: 'Main Showcase', type: 'image', src: fallbackSrc }];
      }

      outputs.forEach((out, idx) => {
        const btn = document.createElement('button');
        btn.className = `output-tab-btn px-3 py-1.5 rounded-lg text-[10px] sm:text-xs font-bold transition-all whitespace-nowrap cursor-pointer flex items-center gap-1.5 shrink-0 ${
          idx === 0 
            ? 'bg-brand-orange text-white shadow-sm' 
            : 'bg-white/10 text-white/80 hover:bg-white/20 hover:text-white'
        }`;

        let iconSvg = '';
        if (out.type === 'video') {
          iconSvg = `<svg class="w-3 h-3 text-brand-orange-light shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>`;
        } else if (out.type === 'pdf') {
          iconSvg = `<svg class="w-3 h-3 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`;
        } else {
          iconSvg = `<svg class="w-3 h-3 text-cyan-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`;
        }

        btn.innerHTML = `${iconSvg}<span>${out.title}</span>`;
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          switchOutput(out, btn);
        });
        modalOutputsBar.appendChild(btn);
      });

      // Switch to first output
      switchOutput(outputs[0], modalOutputsBar.children[0] as HTMLElement);

      // Open Modal
      modal.classList.remove('pointer-events-none', 'opacity-0');
      modal.classList.add('opacity-100');
      modalContainer.classList.remove('scale-95');
      modalContainer.classList.add('scale-100');
    });
  });

  const closeModal = () => {
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0', 'pointer-events-none');
    modalContainer.classList.remove('scale-100');
    modalContainer.classList.add('scale-95');

    // Clean up video play to avoid background audio
    setTimeout(() => {
      modalVideo.pause();
      modalVideo.removeAttribute('src');
      modalVideo.load();
    }, 300);
  };

  document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);
  document.getElementById('modal-close-btn-bottom')?.addEventListener('click', closeModal);

  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('opacity-100')) {
      closeModal();
    }
  });
</script>
