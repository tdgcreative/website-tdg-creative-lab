---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const title = lang === 'en' ? 'Page Not Found — The Digital Grounds' : 'Halaman Tidak Ditemukan — The Digital Grounds';
const description = 'Halaman yang Anda tuju tidak dapat ditemukan.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="min-h-[60vh] flex items-center justify-center py-20">
    <div class="max-w-xl mx-auto px-6 text-center flex flex-col items-center gap-6">
      <span class="text-7xl md:text-9xl font-black text-brand-orange leading-none">404</span>
      <h1 class="text-3xl md:text-4xl font-extrabold uppercase tracking-tight text-brand-dark">
        {t('404.title')}
      </h1>
      <p class="text-sm md:text-base text-brand-dark/60 leading-relaxed max-w-md">
        {t('404.subtitle')}
      </p>
      <a 
        href={translatePath('/')} 
        class="bg-brand-dark hover:bg-brand-orange text-white font-bold px-8 py-3.5 rounded-full transition-colors text-sm uppercase tracking-wider mt-4"
      >
        {t('404.cta')}
      </a>
    </div>
  </section>
</BaseLayout>
