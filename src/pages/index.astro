---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import SimpleCTA from '../components/SimpleCTA.astro';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

// Import Portfolio Images
import fameImg from '../assets/portfolio/fame.jpg';
import aioImg from '../assets/portfolio/aio.png';
import tispunImg from '../assets/portfolio/tispun.jpg';
import naraImg from '../assets/portfolio/nara.jpg';

// Import Client Logos
import asmaralokaLogo from '../assets/logos/ASMARALOKA LOGO.png';
import drsEliorLogo from '../assets/logos/DRS ELIOR LOGO.png';
import invaLogo from '../assets/logos/INVA LOGO.png';
import mirevsLogo from '../assets/logos/MIREVS LOGO.png';
import naraLogo from '../assets/logos/NARA LOGO.png';
import pbpiLogo from '../assets/logos/PBPI Jatim.png';
import panenLogo from '../assets/logos/PT PANEN.png';
import razoLogo from '../assets/logos/RAZO LOGO WHITE.png';
import sodoneLogo from '../assets/logos/SO DONE LOGO.png';
import tispunLogo from '../assets/logos/TISPUN LOGO.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const serviceScopes = [
  {
    number: "01",
    name: "Content & Media Management",
    services: [
      "Social Media Management",
      "Printed Design"
    ]
  },
  {
    number: "02",
    name: "Brand & Digital Foundation",
    services: [
      "Website Development",
      "Brand Development"
    ]
  },
  {
    number: "03",
    name: "Visual Production & Documentation",
    services: [
      "Lookbook Photoshoot",
      "Profile Photoshoot",
      "Event Documentation"
    ]
  },
  {
    number: "04",
    name: "Tactical Executions*",
    services: [
      "Ads Management",
      "KOL Management",
      "Offline Activation",
      "Marketplace Optimization"
    ],
    isExclusive: true
  }
];

const title = "The Digital Grounds — Digital Marketing & Creative Agency Surabaya";
const description = "Ekosistem digital & brand lengkap: social media management, brand development, hingga produksi visual. Dipercaya 50+ brand di Surabaya & Indonesia.";

const clientLogos = [
  { src: asmaralokaLogo, alt: "Asmaraloka" },
  { src: drsEliorLogo, alt: "Drs Elior" },
  { src: invaLogo, alt: "Inva Dental" },
  { src: mirevsLogo, alt: "Mirevs Cafe" },
  { src: naraLogo, alt: "Nara Dental" },
  { src: pbpiLogo, alt: "PBPI Jatim" },
  { src: panenLogo, alt: "PT Panen" },
  { src: razoLogo, alt: "Razo Tooth" },
  { src: sodoneLogo, alt: "So Done" },
  { src: tispunLogo, alt: "Tispun Bakeshop" },
];

const portfolios = [
  {
    title: "FAME",
    category: "Fashion",
    tags: ["Lookbook Photoshoot", "Social Media Management"],
    imageSrc: fameImg,
    svgIcon: "fashion",
    loading: "eager" as const
  },
  {
    title: "AIO Aesthetic Clinic",
    category: "Healthcare",
    tags: ["Social Media", "KOL Management", "Event Documentation"],
    imageSrc: aioImg,
    svgIcon: "healthcare",
    loading: "eager" as const
  },
  {
    title: "Tispun Bakeshop",
    category: "F&B",
    tags: ["Product Photoshoot", "Social Media Management"],
    imageSrc: tispunImg,
    svgIcon: "fnb",
    loading: "lazy" as const
  },
  {
    title: "Nara Dental",
    category: "Healthcare",
    tags: ["Social Media", "Profile Photoshoot", "Event Documentation"],
    imageSrc: naraImg,
    svgIcon: "dental",
    loading: "lazy" as const
  }
];

const industries = [
  "Healthcare",
  "Fashion",
  "F&B",
  "Sport",
  "Architecture & Lifestyle"
];
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <!-- Hero Section -->
  <section class="relative min-h-[70vh] flex items-center justify-center pt-12 pb-20 md:pt-16 md:pb-24 overflow-hidden border-b border-brand-dark/10">
    <!-- Strong Architectural Grid Background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.08)_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] [mask-image:radial-gradient(ellipse_85%_75%_at_50%_50%,#000_80%,transparent_100%)] pointer-events-none" />
    
    <!-- Atmospheric Brand Orange Glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-brand-orange/15 blur-[140px] pointer-events-none" />

    <div class="max-w-7xl mx-auto px-6 w-full text-center relative z-10 flex flex-col items-center gap-6 md:gap-8">
      <h1 class="text-5xl sm:text-6xl md:text-8xl lg:text-9xl font-black tracking-tighter leading-none max-w-5xl uppercase text-brand-dark">
        {t('hero.headline')}
      </h1>
      
      <p class="text-lg md:text-2xl font-medium text-brand-dark/75 max-w-3xl leading-relaxed">
        {t('hero.subheadline')}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mt-4 w-full sm:w-auto">
        <a 
          href={translatePath('/contact')} 
          class="bg-brand-orange hover:bg-brand-orange-light text-white font-bold px-8 py-4 rounded-full transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 text-center text-base"
        >
          {t('nav.contact')}
        </a>
        <a 
          href="#works" 
          class="border border-brand-dark/20 hover:border-brand-dark bg-transparent text-brand-dark font-bold px-8 py-4 rounded-full transition-all duration-300 text-center text-base"
        >
          Explore Works
        </a>
      </div>
    </div>
  </section>

  <!-- Client Logo Marquee Section -->
  <section class="py-10 bg-brand-dark/5 border-y border-brand-dark/10 overflow-hidden relative w-full">
    <div class="max-w-7xl mx-auto px-6 mb-6 text-center">
      <span class="text-[10px] md:text-xs font-bold text-brand-dark/50 uppercase tracking-widest block">Trusted by Premium Brands</span>
    </div>
    <div class="flex overflow-hidden relative w-full select-none">
      <!-- Marquee Track 1 -->
      <div class="flex animate-marquee gap-16 min-w-full items-center justify-around">
        {clientLogos.map((logo) => (
          <div class="flex items-center justify-center h-12 w-28 shrink-0">
            <Image 
              src={logo.src} 
              alt={logo.alt} 
              height={36} 
              class="max-h-full max-w-full object-contain opacity-60 hover:opacity-100 hover:scale-105 transition-all duration-300 grayscale brightness-0" 
            />
          </div>
        ))}
      </div>
      <!-- Marquee Track 2 (Duplicate for loop) -->
      <div class="flex animate-marquee gap-16 min-w-full items-center justify-around" aria-hidden="true">
        {clientLogos.map((logo) => (
          <div class="flex items-center justify-center h-12 w-28 shrink-0">
            <Image 
              src={logo.src} 
              alt={logo.alt} 
              height={36} 
              class="max-h-full max-w-full object-contain opacity-60 hover:opacity-100 hover:scale-105 transition-all duration-300 grayscale brightness-0" 
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Pitch Section -->
  <section class="py-20 md:py-32 bg-brand-dark text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-brand-orange/5 blur-[100px] rounded-full pointer-events-none" />
    
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col gap-6">
        <span class="text-brand-orange font-bold tracking-widest text-xs uppercase">Core Proposition</span>
        <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tight leading-tight">
          {t('pitch.title')}
        </h2>
        <p class="text-base md:text-lg text-white/70 leading-relaxed max-w-2xl">
          {t('pitch.desc')}
        </p>
      </div>

      <!-- Stats Grid -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-6 border-l border-white/10 pl-0 lg:pl-12">
        <div class="flex flex-col gap-2">
          <span class="text-5xl md:text-6xl font-black tracking-tight text-brand-orange">50+</span>
          <span class="text-sm font-semibold text-white/60 uppercase tracking-wider">Brands Trusted</span>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-5xl md:text-6xl font-black tracking-tight text-brand-orange">1</span>
          <span class="text-sm font-semibold text-white/60 uppercase tracking-wider">Integrated Partner</span>
        </div>
        <div class="flex flex-col gap-2 col-span-2 pt-4 border-t border-white/5">
          <span class="text-xs font-bold text-white/50 uppercase tracking-widest block mb-2">Specializations</span>
          <div class="flex flex-wrap gap-2">
            {industries.map((ind) => (
              <span class="bg-white/10 px-3 py-1 rounded-full text-xs font-semibold text-white/80">{ind}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section class="py-20 md:py-32" id="works">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 md:mb-16">
        <div class="flex flex-col gap-4">
          <span class="text-brand-orange font-bold tracking-widest text-xs uppercase">Showcase</span>
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tight text-brand-dark">
            {t('portfolio.title')}
          </h2>
        </div>
        <a 
          href={translatePath('/works-and-services')} 
          class="inline-flex items-center gap-2 font-bold text-sm text-brand-dark group hover:text-brand-orange transition-colors"
        >
          {t('portfolio.cta')}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transform transition-transform duration-300 group-hover:translate-x-1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <!-- Portfolio Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {portfolios.map((portfolio) => (
          <PortfolioCard 
            title={portfolio.title}
            category={portfolio.category}
            tags={portfolio.tags}
            imageSrc={portfolio.imageSrc}
            svgIcon={portfolio.svgIcon}
            loading={portfolio.loading}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Service Scopes Section -->
  <section class="py-20 md:py-32 bg-white border-t border-brand-dark/5" id="services">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col gap-4 mb-16 text-center md:text-left">
        <span class="text-brand-orange font-bold tracking-widest text-xs uppercase">Capabilities</span>
        <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tight text-brand-dark">
          {t('home.scopes.title')}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {serviceScopes.map((scope) => (
          <div class={`p-8 rounded-3xl border flex flex-col justify-between min-h-[300px] transition-all duration-300 ${
            scope.isExclusive 
              ? 'bg-brand-dark text-white border-brand-dark' 
              : 'bg-brand-bg text-brand-dark border-brand-dark/5 shadow-sm'
          }`}>
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class={`text-[10px] font-bold tracking-widest uppercase ${scope.isExclusive ? 'text-brand-orange' : 'text-brand-dark/40'}`}>
                  Scope {scope.number}
                </span>
                <span class={`text-3xl font-black leading-none ${scope.isExclusive ? 'text-brand-orange/40' : 'text-brand-orange/20'}`}>
                  {scope.number}
                </span>
              </div>
              
              <h3 class="text-xl font-black uppercase tracking-tight mb-4 leading-snug">
                {scope.name}
              </h3>
              
              <ul class="flex flex-col gap-2">
                {scope.services.map((service) => (
                  <li class="flex items-center gap-2 text-xs font-semibold">
                    <span class={`w-1.5 h-1.5 rounded-full ${scope.isExclusive ? 'bg-brand-orange' : 'bg-brand-dark/35'}`}></span>
                    {service}
                  </li>
                ))}
              </ul>
            </div>

            {scope.isExclusive && (
              <div class="mt-6 pt-6 border-t border-white/10 flex flex-col gap-4">
                <p class="text-[10px] text-white/50 leading-relaxed italic">
                  {t('works.note')}
                </p>
                <a 
                  href={translatePath('/contact')} 
                  class="bg-brand-orange hover:bg-brand-orange-light text-white font-bold text-center px-6 py-2.5 rounded-full transition-all duration-300 text-xs shadow-md"
                >
                  {t('works.cta')}
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Expertise Section -->
  <section class="py-20 bg-brand-dark/5 border-t border-brand-dark/5 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 text-center flex flex-col items-center gap-8">
      <span class="text-brand-orange font-bold tracking-widest text-xs uppercase">{t('expertise.title')}</span>
      <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tight text-brand-dark max-w-3xl leading-tight">
        Supporting Diverse Industries in the Creative Sphere
      </h2>
      <div class="flex flex-wrap justify-center gap-3 md:gap-4 max-w-4xl mt-4">
        {industries.map((ind) => (
          <div class="bg-white border border-brand-dark/10 px-6 py-3.5 rounded-2xl text-sm md:text-base font-extrabold text-brand-dark tracking-tight shadow-sm hover:border-brand-orange hover:text-brand-orange transition-colors cursor-default">
            {ind}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Simple Consultation WhatsApp CTA Section -->
  <SimpleCTA />
</BaseLayout>
