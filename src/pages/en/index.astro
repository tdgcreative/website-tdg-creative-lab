---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioCard from '../../components/PortfolioCard.astro';
import SimpleCTA from '../../components/SimpleCTA.astro';
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

// Import Portfolio Images
import fameImg from '../../assets/portfolio/fame.jpg';
import aioImg from '../../assets/portfolio/aio.png';
import tispunImg from '../../assets/portfolio/tispun.jpg';
import naraImg from '../../assets/portfolio/nara.jpg';

// Import Client Logos
import asmaralokaLogo from '../../assets/logos/ASMARALOKA LOGO.png';
import drsEliorLogo from '../../assets/logos/DRS ELIOR LOGO.png';
import invaLogo from '../../assets/logos/INVA LOGO.png';
import mirevsLogo from '../../assets/logos/MIREVS LOGO.png';
import naraLogo from '../../assets/logos/NARA LOGO.png';
import pbpiLogo from '../../assets/logos/PBPI Jatim.png';
import panenLogo from '../../assets/logos/PT PANEN.png';
import razoLogo from '../../assets/logos/RAZO LOGO WHITE.png';
import sodoneLogo from '../../assets/logos/SO DONE LOGO.png';
import tispunLogo from '../../assets/logos/TISPUN LOGO.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const serviceScopes = [
  {
    number: "01",
    name: "Content & Media Management",
    services: [
      "Social Media Management",
      "Printed Design"
    ],
    filter: "content-media"
  },
  {
    number: "02",
    name: "Brand & Digital Foundation",
    services: [
      "Website Development",
      "Brand Development"
    ],
    filter: "brand-digital"
  },
  {
    number: "03",
    name: "Visual Production & Documentation",
    services: [
      "Lookbook Photoshoot",
      "Profile Photoshoot",
      "Event Documentation"
    ],
    filter: "visual-doc"
  },
  {
    number: "04",
    name: "Tactical Executions*",
    services: [
      "Ads Management",
      "KOL Management",
      "Offline Activation",
      "Marketplace Optimization"
    ],
    isExclusive: true
  }
];

const title = "The Digital Grounds — Digital Marketing & Creative Agency Surabaya";
const description = "Complete digital & brand ecosystem: social media management, brand development, visual production. Trusted by 50+ brands in Surabaya & Indonesia.";

const clientLogos = [
  { src: asmaralokaLogo, alt: "Asmaraloka", heightClass: "h-5 sm:h-6" },
  { src: drsEliorLogo, alt: "Drs Elior", heightClass: "h-7 sm:h-8" },
  { src: invaLogo, alt: "Inva Dental", heightClass: "h-8 sm:h-9" },
  { src: mirevsLogo, alt: "Mirevs Cafe", heightClass: "h-5 sm:h-6" },
  { src: naraLogo, alt: "Nara Dental", heightClass: "h-8 sm:h-9" },
  { src: pbpiLogo, alt: "PBPI Jatim", heightClass: "h-7 sm:h-8" },
  { src: panenLogo, alt: "PT Panen", heightClass: "h-6 sm:h-7" },
  { src: razoLogo, alt: "Razo Tooth", heightClass: "h-6 sm:h-7" },
  { src: sodoneLogo, alt: "So Done", heightClass: "h-8 sm:h-9" },
  { src: tispunLogo, alt: "Tispun Bakeshop", heightClass: "h-6 sm:h-7" },
];

const marqueeList = [...clientLogos, ...clientLogos];

const portfolios = [
  {
    title: "FAME",
    category: "Fashion",
    tags: ["Lookbook Photoshoot", "Social Media Management"],
    imageSrc: fameImg,
    svgIcon: "fashion",
    loading: "eager" as const
  },
  {
    title: "AIO Aesthetic Clinic",
    category: "Healthcare",
    tags: ["Social Media", "KOL Management", "Event Documentation"],
    imageSrc: aioImg,
    svgIcon: "healthcare",
    loading: "eager" as const
  },
  {
    title: "Tispun Bakeshop",
    category: "F&B",
    tags: ["Product Photoshoot", "Social Media Management"],
    imageSrc: tispunImg,
    svgIcon: "fnb",
    loading: "lazy" as const
  },
  {
    title: "Nara Dental",
    category: "Healthcare",
    tags: ["Social Media", "Profile Photoshoot", "Event Documentation"],
    imageSrc: naraImg,
    svgIcon: "dental",
    loading: "lazy" as const
  }
];

const industries = [
  "Healthcare",
  "Fashion",
  "F&B",
  "Sport",
  "Architecture & Lifestyle"
];
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <!-- Hero Section -->
  <section class="relative min-h-[65vh] sm:min-h-[70vh] flex items-center justify-center pt-8 pb-16 sm:pt-12 sm:pb-20 md:pt-16 md:pb-24 overflow-hidden border-b border-brand-dark/10">
    <!-- Strong Architectural Grid Background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.08)_1px,transparent_1px)] bg-[size:2.5rem_2.5rem] sm:bg-[size:3.5rem_3.5rem] [mask-image:radial-gradient(ellipse_85%_75%_at_50%_50%,#000_80%,transparent_100%)] pointer-events-none" />
    
    <!-- Atmospheric Brand Orange Glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[600px] h-[350px] sm:h-[600px] rounded-full bg-brand-orange/15 blur-[100px] sm:blur-[140px] pointer-events-none" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 w-full text-center relative z-10 flex flex-col items-center gap-5 sm:gap-6 md:gap-8">
      <!-- Two-tier Hierarchical Hero Headline: Massive "TDG" + Refined Wide "CREATIVE LAB" -->
      <h1 class="flex flex-col items-center justify-center uppercase text-brand-dark select-none text-center max-w-5xl">
        <span class="text-6xl sm:text-8xl md:text-9xl lg:text-[10.5rem] xl:text-[12.5rem] font-black leading-none tracking-tighter">
          {t('hero.headline.main')}
        </span>
        <span class="text-xl sm:text-3xl md:text-4xl lg:text-5xl font-black tracking-[0.25em] sm:tracking-[0.3em] md:tracking-[0.35em] text-brand-dark/90 mt-1 sm:mt-2 md:mt-3 pl-[0.25em] sm:pl-[0.3em] md:pl-[0.35em]">
          {t('hero.headline.sub')}
        </span>
      </h1>
      
      <p class="text-base sm:text-lg md:text-xl lg:text-2xl font-medium text-brand-dark/75 max-w-3xl leading-relaxed px-2">
        {t('hero.subheadline')}
      </p>

      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mt-2 sm:mt-4 w-full sm:w-auto px-2 sm:px-0">
        <a 
          href={translatePath('/contact')} 
          class="bg-brand-orange hover:bg-brand-orange-light text-white font-bold px-7 sm:px-8 py-3.5 sm:py-4 rounded-full transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 text-center text-sm sm:text-base w-full sm:w-auto"
        >
          {t('nav.contact')}
        </a>
        <a 
          href="#works" 
          class="border border-brand-dark/20 hover:border-brand-dark bg-transparent text-brand-dark font-bold px-7 sm:px-8 py-3.5 sm:py-4 rounded-full transition-all duration-300 text-center text-sm sm:text-base w-full sm:w-auto"
        >
          Explore Works
        </a>
      </div>
    </div>
  </section>

  <!-- Client Logo Marquee Section -->
  <section class="py-10 sm:py-14 bg-brand-dark/5 border-y border-brand-dark/10 overflow-hidden relative w-full">
    <div class="max-w-7xl mx-auto px-6 mb-6 sm:mb-8 text-center">
      <span class="text-[10px] sm:text-xs font-bold text-brand-dark/50 uppercase tracking-widest block">Trusted by Premium Brands</span>
    </div>
    
    <!-- Seamless Infinite Marquee with Soft Edge Vignette -->
    <div class="flex overflow-hidden relative w-full select-none [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] [-webkit-mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
      <!-- Marquee Track 1 -->
      <div class="flex shrink-0 items-center gap-12 sm:gap-16 md:gap-20 animate-marquee pr-12 sm:pr-16 md:pr-20">
        {marqueeList.map((logo) => (
          <div class="flex items-center justify-center shrink-0">
            <Image 
              src={logo.src} 
              alt={logo.alt} 
              class={`w-auto object-contain opacity-65 hover:opacity-100 transition-opacity duration-300 ${logo.heightClass}`} 
            />
          </div>
        ))}
      </div>
      <!-- Marquee Track 2 (Duplicate for infinite seamless loop) -->
      <div class="flex shrink-0 items-center gap-12 sm:gap-16 md:gap-20 animate-marquee pr-12 sm:pr-16 md:pr-20" aria-hidden="true">
        {marqueeList.map((logo) => (
          <div class="flex items-center justify-center shrink-0">
            <Image 
              src={logo.src} 
              alt={logo.alt} 
              class={`w-auto object-contain opacity-65 hover:opacity-100 transition-opacity duration-300 ${logo.heightClass}`} 
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Pitch Section -->
  <section class="py-16 sm:py-20 md:py-32 bg-brand-dark text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-brand-orange/5 blur-[100px] rounded-full pointer-events-none" />
    
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col gap-4 sm:gap-6">
        <span class="text-brand-orange font-bold tracking-widest text-[10px] sm:text-xs uppercase">Core Proposition</span>
        <h2 class="text-2xl sm:text-3xl md:text-5xl font-black uppercase tracking-tight leading-tight">
          {t('pitch.title')}
        </h2>
        <p class="text-sm sm:text-base md:text-lg text-white/70 leading-relaxed max-w-2xl">
          {t('pitch.desc')}
        </p>
      </div>

      <!-- Stats Grid -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-6 border-t pt-8 lg:border-t-0 lg:pt-0 lg:border-l border-white/10 pl-0 lg:pl-12">
        <div class="flex flex-col gap-1 sm:gap-2">
          <span class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-brand-orange">50+</span>
          <span class="text-xs sm:text-sm font-semibold text-white/60 uppercase tracking-wider">Brands Trusted</span>
        </div>
        <div class="flex flex-col gap-1 sm:gap-2">
          <span class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-brand-orange">3</span>
          <span class="text-xs sm:text-sm font-semibold text-white/60 uppercase tracking-wider">Core Scopes</span>
        </div>
        <div class="flex flex-col gap-2 col-span-2 pt-4 border-t border-white/5">
          <span class="text-[10px] sm:text-xs font-bold text-white/50 uppercase tracking-widest block mb-2">Specializations</span>
          <div class="flex flex-wrap gap-1.5 sm:gap-2">
            {industries.map((ind) => (
              <span class="bg-white/10 px-3 py-1 rounded-full text-[10px] sm:text-xs font-semibold text-white/80">{ind}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section class="py-16 sm:py-20 md:py-32" id="works">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 sm:gap-6 mb-8 sm:mb-12 md:mb-16">
        <div class="flex flex-col gap-2 sm:gap-4">
          <span class="text-brand-orange font-bold tracking-widest text-[10px] sm:text-xs uppercase">Showcase</span>
          <h2 class="text-3xl sm:text-4xl md:text-6xl font-black uppercase tracking-tight text-brand-dark">
            {t('portfolio.title')}
          </h2>
        </div>
        <a 
          href={translatePath('/works-and-services')} 
          class="inline-flex items-center gap-2.5 bg-brand-dark hover:bg-brand-orange text-white font-bold text-xs sm:text-sm px-6 py-3 rounded-full transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-0.5 group w-fit self-start sm:self-auto shrink-0"
        >
          <span>{t('portfolio.cta')}</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transform transition-transform duration-300 group-hover:translate-x-1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <!-- Portfolio Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {portfolios.map((portfolio) => (
          <PortfolioCard 
            title={portfolio.title}
            category={portfolio.category}
            tags={portfolio.tags}
            imageSrc={portfolio.imageSrc}
            svgIcon={portfolio.svgIcon}
            loading={portfolio.loading}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Service Scopes Section -->
  <section class="py-16 sm:py-20 md:py-32 bg-white border-t border-brand-dark/5" id="services">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col gap-2 sm:gap-4 mb-10 sm:mb-16 text-center md:text-left">
        <span class="text-brand-orange font-bold tracking-widest text-[10px] sm:text-xs uppercase">Capabilities</span>
        <h2 class="text-3xl sm:text-4xl md:text-6xl font-black uppercase tracking-tight text-brand-dark">
          {t('home.scopes.title')}
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        {serviceScopes.map((scope) => (
          <div class={`p-6 sm:p-8 rounded-2xl sm:rounded-3xl border flex flex-col justify-between min-h-[260px] sm:min-h-[300px] transition-all duration-300 ${
            scope.isExclusive 
              ? 'bg-brand-dark text-white border-brand-dark' 
              : 'bg-brand-bg text-brand-dark border-brand-dark/5 shadow-sm'
          }`}>
            <div>
              <div class="flex items-center justify-between mb-5 sm:mb-6">
                <span class={`text-[10px] font-bold tracking-widest uppercase ${scope.isExclusive ? 'text-brand-orange' : 'text-brand-dark/40'}`}>
                  Scope {scope.number}
                </span>
                <span class={`text-2xl sm:text-3xl font-black leading-none ${scope.isExclusive ? 'text-brand-orange/40' : 'text-brand-orange/20'}`}>
                  {scope.number}
                </span>
              </div>
              
              <h3 class="text-lg sm:text-xl font-black uppercase tracking-tight mb-3 sm:mb-4 leading-snug">
                {scope.name}
              </h3>
              
              <ul class="flex flex-col gap-2">
                {scope.services.map((service) => (
                  <li class="flex items-center gap-2 text-xs font-semibold">
                    <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${scope.isExclusive ? 'bg-brand-orange' : 'bg-brand-dark/35'}`}></span>
                    <span>{service}</span>
                  </li>
                ))}
              </ul>
            </div>

            {!scope.isExclusive && (
              <div class="mt-6 pt-5 sm:pt-6 border-t border-brand-dark/10 flex flex-col">
                <a 
                  href={`${translatePath('/works-and-services')}?filter=${scope.filter}`} 
                  class="inline-flex items-center justify-between w-full border border-brand-dark/20 hover:border-brand-dark hover:bg-brand-dark hover:text-white text-brand-dark font-bold px-4 py-2.5 rounded-full transition-all duration-300 text-xs group"
                >
                  <span>{t('scope.cta.explore')}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 transform transition-transform duration-300 group-hover:translate-x-1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            )}

            {scope.isExclusive && (
              <div class="mt-6 pt-5 sm:pt-6 border-t border-white/10 flex flex-col gap-3 sm:gap-4">
                <p class="text-[10px] text-white/50 leading-relaxed italic">
                  {t('works.note')}
                </p>
                <a 
                  href={translatePath('/contact')} 
                  class="bg-brand-orange hover:bg-brand-orange-light text-white font-bold text-center px-5 sm:px-6 py-2.5 rounded-full transition-all duration-300 text-xs shadow-md"
                >
                  {t('works.cta')}
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Expertise Section -->
  <section class="py-14 sm:py-20 bg-brand-dark/5 border-t border-brand-dark/5 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 text-center flex flex-col items-center gap-6 sm:gap-8">
      <span class="text-brand-orange font-bold tracking-widest text-[10px] sm:text-xs uppercase">{t('expertise.title')}</span>
      <h2 class="text-2xl sm:text-3xl md:text-5xl font-black uppercase tracking-tight text-brand-dark max-w-3xl leading-tight">
        Supporting Diverse Industries in the Creative Sphere
      </h2>
      <div class="flex flex-wrap justify-center gap-2.5 sm:gap-4 max-w-4xl mt-2 sm:mt-4">
        {industries.map((ind) => (
          <div class="bg-white border border-brand-dark/10 px-4 py-2.5 sm:px-6 sm:py-3.5 rounded-xl sm:rounded-2xl text-xs sm:text-sm md:text-base font-extrabold text-brand-dark tracking-tight shadow-sm hover:border-brand-orange hover:text-brand-orange transition-colors cursor-default">
            {ind}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Simple Consultation WhatsApp CTA Section -->
  <SimpleCTA />
</BaseLayout>
