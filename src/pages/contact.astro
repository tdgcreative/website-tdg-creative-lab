---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { loadSettingsData } from '../utils/data-loader';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const settings = loadSettingsData();

const title = settings.contact?.seo?.id?.title || "Hubungi Kami — The Digital Grounds";
const description = settings.contact?.seo?.id?.description || "Siap mengembangkan brand Anda? Sampaikan kebutuhan bisnis Anda dan tim kami siapkan kerangka eksekusinya.";

const contactTag = settings.contact?.tag?.id || "Get in Touch";
const contactTitle = settings.contact?.title?.id || t('contact.title');
const contactSubtitle = settings.contact?.subtitle?.id || t('contact.subtitle');
const contactEmail = settings.contact?.email || "tdg.creative.lab@gmail.com";
const waNum = (settings.whatsapp?.number || "628138238837").replace(/[^0-9]/g, '');
const waDisplay = settings.whatsapp?.display || "+62 813-8238-837";
const contactLocation = settings.contact?.location?.id || t('contact.info.address');

const budgetRanges = settings.contact?.budgetRanges?.id || [
  "< Rp 10 Juta / bulan",
  "Rp 10 Juta - Rp 25 Juta / bulan",
  "Rp 25 Juta - Rp 50 Juta / bulan",
  "Rp 50 Juta - Rp 100 Juta / bulan",
  "> Rp 100 Juta / bulan"
];
---

<BaseLayout title={title} description={description} canonicalPath="/contact">
  <section class="py-12 sm:py-16 md:py-24 relative overflow-hidden">
    <!-- Background grid decoration -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,0,0,0.015)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.015)_1px,transparent_1px)] bg-[size:3rem_3rem] pointer-events-none" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-20">
      
      <!-- Left Column: Contact info & NAP details -->
      <div class="lg:col-span-5 flex flex-col justify-between gap-8 sm:gap-12">
        <div class="flex flex-col gap-3 sm:gap-6">
          <span id="contact-page-tag" class="text-brand-orange font-bold tracking-widest text-[10px] sm:text-xs uppercase">{contactTag}</span>
          <h1 id="contact-page-title" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight text-brand-dark leading-tight">
            {contactTitle}
          </h1>
          <p id="contact-page-subtitle" class="text-sm sm:text-base md:text-lg text-brand-dark/70 leading-relaxed">
            {contactSubtitle}
          </p>
        </div>

        <div class="flex flex-col gap-6 sm:gap-8 border-t border-brand-dark/10 pt-8 sm:pt-10">
          <!-- Email Info -->
          <div class="flex items-start gap-3.5 sm:gap-4">
            <div class="p-2.5 sm:p-3 bg-brand-dark text-white rounded-xl sm:rounded-2xl shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 sm:w-6 sm:h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <span class="block text-[10px] sm:text-xs font-bold text-brand-dark/50 uppercase tracking-widest">{t('contact.info.email')}</span>
              <a href={`mailto:${contactEmail}`} data-contact-email class="text-sm sm:text-base md:text-lg font-extrabold hover:text-brand-orange transition-colors break-all">
                {contactEmail}
              </a>
            </div>
          </div>

          <!-- WhatsApp Info -->
          <div class="flex items-start gap-3.5 sm:gap-4">
            <div class="p-2.5 sm:p-3 bg-brand-dark text-white rounded-xl sm:rounded-2xl shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 sm:w-6 sm:h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.302a12.036 12.036 0 01-5.242-5.242c-.44-.441-.274-.927.102-1.21l1.293-.97a1.125 1.125 0 00.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <div>
              <span class="block text-[10px] sm:text-xs font-bold text-brand-dark/50 uppercase tracking-widest">{t('contact.info.wa')}</span>
              <a href={`https://wa.me/${waNum}`} data-wa-link data-wa-display target="_blank" rel="noopener noreferrer" class="text-sm sm:text-base md:text-lg font-extrabold hover:text-brand-orange transition-colors">
                {waDisplay}
              </a>
            </div>
          </div>

          <!-- Location Info -->
          <div class="flex items-start gap-3.5 sm:gap-4">
            <div class="p-2.5 sm:p-3 bg-brand-dark text-white rounded-xl sm:rounded-2xl shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 sm:w-6 sm:h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25s-7.5-4.108-7.5-11.25a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <span class="block text-[10px] sm:text-xs font-bold text-brand-dark/50 uppercase tracking-widest">{t('contact.info.loc')}</span>
              <span data-contact-location class="text-sm sm:text-base md:text-lg font-extrabold text-brand-dark leading-relaxed block">
                {contactLocation}
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: The Contact Form -->
      <div class="lg:col-span-7">
        <div class="bg-white p-6 sm:p-8 md:p-12 rounded-2xl sm:rounded-3xl border border-brand-dark/10 shadow-sm">
          <form id="contact-form" class="flex flex-col gap-5 sm:gap-6" data-thanks-url={translatePath('/thanks')}>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
              <!-- Company Name -->
              <div class="flex flex-col gap-1.5 sm:gap-2">
                <label for="company-name" class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-brand-dark/60">
                  {t('form.companyName')} <span class="text-brand-orange">*</span>
                </label>
                <input 
                  type="text" 
                  id="company-name" 
                  name="companyName" 
                  required 
                  placeholder="e.g. Acme Corp" 
                  class="w-full px-3.5 sm:px-4 py-3 rounded-xl border border-brand-dark/15 focus:border-brand-orange focus:outline-none transition-colors text-base md:text-sm"
                />
              </div>

              <!-- Company Location -->
              <div class="flex flex-col gap-1.5 sm:gap-2">
                <label for="company-location" class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-brand-dark/60">
                  {t('form.companyLocation')} <span class="text-brand-orange">*</span>
                </label>
                <input 
                  type="text" 
                  id="company-location" 
                  name="companyLocation" 
                  required 
                  placeholder="e.g. Surabaya, Jakarta" 
                  class="w-full px-3.5 sm:px-4 py-3 rounded-xl border border-brand-dark/15 focus:border-brand-orange focus:outline-none transition-colors text-base md:text-sm"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
              <!-- PIC Name -->
              <div class="flex flex-col gap-1.5 sm:gap-2">
                <label for="pic-name" class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-brand-dark/60">
                  {t('form.picName')} <span class="text-brand-orange">*</span>
                </label>
                <input 
                  type="text" 
                  id="pic-name" 
                  name="picName" 
                  required 
                  placeholder="e.g. John Doe" 
                  class="w-full px-3.5 sm:px-4 py-3 rounded-xl border border-brand-dark/15 focus:border-brand-orange focus:outline-none transition-colors text-base md:text-sm"
                />
              </div>

              <!-- WhatsApp Number -->
              <div class="flex flex-col gap-1.5 sm:gap-2">
                <label for="pic-wa" class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-brand-dark/60">
                  {t('form.picWa')} <span class="text-brand-orange">*</span>
                </label>
                <input 
                  type="tel" 
                  id="pic-wa" 
                  name="picWa" 
                  required 
                  placeholder="e.g. 08123456789" 
                  class="w-full px-3.5 sm:px-4 py-3 rounded-xl border border-brand-dark/15 focus:border-brand-orange focus:outline-none transition-colors text-base md:text-sm"
                />
              </div>
            </div>

            <!-- Email Address -->
            <div class="flex flex-col gap-1.5 sm:gap-2">
              <label for="pic-email" class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-brand-dark/60">
                {t('form.picEmail')} <span class="text-brand-orange">*</span>
              </label>
              <input 
                type="email" 
                id="pic-email" 
                name="picEmail" 
                required 
                placeholder="e.g. john@company.com" 
                class="w-full px-3.5 sm:px-4 py-3 rounded-xl border border-brand-dark/15 focus:border-brand-orange focus:outline-none transition-colors text-base md:text-sm"
              />
            </div>

            <!-- Budget Dropdown -->
            <div class="flex flex-col gap-1.5 sm:gap-2">
              <label for="budget" class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-brand-dark/60">
                {t('form.budget')} <span class="text-brand-orange">*</span>
              </label>
              <select 
                id="budget" 
                name="budget" 
                required 
                class="w-full px-3.5 sm:px-4 py-3 rounded-xl border border-brand-dark/15 focus:border-brand-orange focus:outline-none transition-colors text-base md:text-sm bg-white"
              >
                <option value="" disabled selected>{t('form.budget.select')}</option>
                {budgetRanges.map((range) => (
                  <option value={range}>{range}</option>
                ))}
              </select>
            </div>

            <!-- Needs/Message -->
            <div class="flex flex-col gap-1.5 sm:gap-2">
              <label for="message" class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-brand-dark/60">
                {t('form.message')} <span class="text-brand-orange">*</span>
              </label>
              <textarea 
                id="message" 
                name="message" 
                required 
                rows="4" 
                placeholder="Ceritakan target bisnismu dan ruang lingkup yang kamu butuhkan..." 
                class="w-full px-3.5 sm:px-4 py-3 rounded-xl border border-brand-dark/15 focus:border-brand-orange focus:outline-none transition-colors text-base md:text-sm resize-none"
              />
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              id="submit-btn"
              class="w-full bg-brand-orange hover:bg-brand-orange-light text-white font-extrabold py-3.5 sm:py-4 rounded-xl transition-colors text-sm uppercase tracking-wider shadow-sm hover:shadow-md cursor-pointer mt-2"
            >
              {t('form.submit')}
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getSupabaseClient } from '../utils/supabase';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.checkValidity()) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerText = form.getAttribute('data-thanks-url')?.includes('/en') 
        ? 'Sending...' 
        : 'Mengirim...';
    }

    setTimeout(() => {
      const thanksUrl = form.getAttribute('data-thanks-url') || '/thanks';
      window.location.href = thanksUrl;
    }, 1200);
  });

  function syncContactPage(settings: any) {
    if (!settings?.contact) return;
    const c = settings.contact;
    const tagEl = document.getElementById('contact-page-tag');
    const titleEl = document.getElementById('contact-page-title');
    const subEl = document.getElementById('contact-page-subtitle');
    const budgetEl = document.getElementById('budget') as HTMLSelectElement | null;

    if (tagEl && c.tag?.id) tagEl.textContent = c.tag.id;
    if (titleEl && c.title?.id) titleEl.textContent = c.title.id;
    if (subEl && c.subtitle?.id) subEl.textContent = c.subtitle.id;
    if (budgetEl && Array.isArray(c.budgetRanges?.id) && c.budgetRanges.id.length > 0) {
      const firstOpt = budgetEl.options[0]?.outerHTML || '<option value="" disabled selected>Pilih rentang budget</option>';
      budgetEl.innerHTML = firstOpt + c.budgetRanges.id.map((r: string) => `<option value="${r}">${r}</option>`).join('');
    }
  }

  try {
    const raw = localStorage.getItem('tdg_cms_state_v1');
    if (raw) {
      const parsed = JSON.parse(raw);
      if (parsed?.settings) syncContactPage(parsed.settings);
    }
  } catch {}

  (async () => {
    try {
      const supabase = getSupabaseClient();
      const { data } = await supabase.from('site_settings').select('data').eq('key', 'settings').maybeSingle();
      if (data?.data) syncContactPage(data.data);
    } catch {}
  })();
</script>
