          subtitle: 'Status koneksi database cloud Supabase dan skema tabel.',
          showLang: false,
        },
      };

      function switchPanel(panel: typeof state.activePanel) {
        readCurrentPanelIntoState();
        state.activePanel = panel;

        document.querySelectorAll('.admin-panel').forEach((el) => el.classList.add('hidden'));
        document.getElementById(`panel-${panel}`)?.classList.remove('hidden');

        document.querySelectorAll('.sidebar-nav-btn').forEach((btn) => {
          if (btn.getAttribute('data-nav') === panel) {
            btn.className = 'sidebar-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-[#141414] text-white';
          } else {
