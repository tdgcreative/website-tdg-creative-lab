      function showToast(msg: string, isError = false) {
        const toast = document.getElementById('admin-toast')!;
        const toastMsg = document.getElementById('admin-toast-msg')!;
        toastMsg.textContent = msg;
        toast.classList.remove('translate-y-24', 'opacity-0', 'border-brand-orange', 'border-red-500');
        toast.classList.add(isError ? 'border-red-500' : 'border-brand-orange');
        setTimeout(() => {
          toast.classList.add('translate-y-24', 'opacity-0');
        }, 3800);
      }

      function getGhConfig() {
        try {
          const raw = localStorage.getItem(GH_CONFIG_KEY);
          if (raw) return JSON.parse(raw);
        } catch {}
        return {
          repo: 'tdgcreative/website-tdg-creative-lab',
          branch: 'main',
          token: ''
        };
      }

      async function githubCommitFile(filePath: string, contentString: string, commitMessage: string, isBase64 = false) {
        const cfg = getGhConfig();
        if (!cfg.token) {
          throw new Error('Mode Cloud membutuhkan GitHub Token (klik ⚙️ GitHub Config di kanan atas).');
        }
        const apiUrl = `https://api.github.com/repos/${cfg.repo}/contents/${filePath}`;
        let sha: string | undefined;

        const getRes = await fetch(`${apiUrl}?ref=${cfg.branch}`, {
          headers: {
            Authorization: `Bearer ${cfg.token}`,
            Accept: 'application/vnd.github+json'
          }
        });
        if (getRes.ok) {
          const existing = await getRes.json();
          sha = existing.sha;
        }

        const base64Content = isBase64
          ? contentString
          : btoa(unescape(encodeURIComponent(contentString)));

        const putRes = await fetch(apiUrl, {
          method: 'PUT',
          headers: {
            Authorization: `Bearer ${cfg.token}`,
            Accept: 'application/vnd.github+json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            message: commitMessage,
            content: base64Content,
            branch: cfg.branch,
            ...(sha ? { sha } : {})
          })
        });

        if (!putRes.ok) {
          const errData = await putRes.json().catch(() => ({}));
          throw new Error(errData.message || `GitHub API error (${putRes.status})`);
        }
        return await putRes.json();
      }

      async function saveResource(endpoint: 'home' | 'portfolios' | 'blog', data: any) {
        if (state.mode === 'local') {
          const res = await fetch(`/api/admin/${endpoint}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const json = await res.json();
          if (!res.ok || !json.ok) throw new Error(json.error || 'Gagal menyimpan data');
          return json.message;
        } else {
          const fileMap = {
            home: 'src/data/home.json',
            portfolios: 'src/data/portfolios.json',
            blog: 'src/data/blog.json'
          };
          await githubCommitFile(
            fileMap[endpoint],
            JSON.stringify(data, null, 2) + '\n',
            `chore(cms): update ${endpoint} via TDG Admin`
          );
          return `Berhasil di-commit ke GitHub (${fileMap[endpoint]})!`;
        }
      }

      async function uploadMediaFile(file: File, folder: 'portfolio' | 'logos' | 'blog' | 'videos' | 'docs'): Promise<string> {
        const dataUrl: string = await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result as string);
          reader.onerror = reject;
          reader.readAsDataURL(file);
        });

        if (state.mode === 'local') {
          const res = await fetch('/api/admin/upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: file.name, folder, dataUrl })
          });
          const json = await res.json();
          if (!res.ok || !json.ok) throw new Error(json.error || 'Gagal mengunggah file');
          return json.url;
        } else {
          const safeName = file.name.toLowerCase().replace(/[^a-z0-9._-]/g, '-').replace(/-+/g, '-');
          const folderMap: Record<string, string> = {
            portfolio: 'public/images/portfolio',
            logos: 'public/images/logos',
            blog: 'public/images/blog',
            videos: 'public/videos',
            docs: 'public/docs'
          };
          const relDir = folderMap[folder] || 'public/images/portfolio';
          const base64Clean = dataUrl.includes(',') ? dataUrl.split(',')[1] : dataUrl;
          await githubCommitFile(`${relDir}/${safeName}`, base64Clean, `chore(cms): upload ${safeName}`, true);
          return '/' + relDir.replace(/^public\//, '') + '/' + safeName;
        }
      }

