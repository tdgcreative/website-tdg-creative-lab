                <pre id="sql-schema-box" class="bg-[#141414] text-emerald-400 p-4 rounded-xl text-[11px] font-mono overflow-x-auto max-h-56 leading-relaxed">CREATE TABLE IF NOT EXISTS public.blog_articles (
