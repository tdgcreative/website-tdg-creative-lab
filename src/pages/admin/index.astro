      document.querySelectorAll('.blog-lang-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          readBlogEditorIntoWorking();
          state.blogLang = (btn.getAttribute('data-blog-lang') as 'id' | 'en') || 'id';
          document.querySelectorAll('.blog-lang-btn').forEach((b) => {
            const active = b.getAttribute('data-blog-lang') === state.blogLang;
            b.classList.toggle('bg-brand-orange', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('text-white/60', !active);
          });
          syncBlogEditorFromWorking();
        });
      });

      [
        'blog-focus-keyword',
        'blog-slug',
        'blog-title',
        'blog-seo-title',
        'blog-cover-alt',
        'blog-seo-desc',
        'blog-excerpt',
        'blog-tags',
        'blog-content'
      ].forEach((id) => {
        document.getElementById(id)?.addEventListener('input', updateLiveSeoPanel);
      });

      document.getElementById('btn-auto-slug')?.addEventListener('click', () => {
        const titleVal = (document.getElementById('blog-title') as HTMLInputElement).value.trim();
        if (!titleVal) return;
        const generatedSlug = titleVal
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-');
        (document.getElementById('blog-slug') as HTMLInputElement).value = generatedSlug;
        const seoTitleInput = document.getElementById('blog-seo-title') as HTMLInputElement;
        if (!seoTitleInput.value) {
          seoTitleInput.value = `${titleVal.slice(0, 50)} — TDG`;
        }
        updateLiveSeoPanel();
      });

      // Markdown Toolbar Helpers
      document.querySelectorAll('.md-tool-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-md');
          const textarea = document.getElementById('blog-content') as HTMLTextAreaElement;
          const start = textarea.selectionStart;
          const end = textarea.selectionEnd;
          const selected = textarea.value.slice(start, end) || 'Teks';
          let insert = '';

          if (action === 'h2') insert = `\n## ${selected}\n`;
          else if (action === 'h3') insert = `\n### ${selected}\n`;
          else if (action === 'bold') insert = `**${selected}**`;
          else if (action === 'italic') insert = `*${selected}*`;
          else if (action === 'quote') insert = `\n> ${selected}\n`;
          else if (action === 'ul') insert = `\n- ${selected}\n`;
          else if (action === 'link-works') {
            insert =
              state.blogLang === 'id'
                ? `[Portofolio & Layanan TDG](/works-and-services)`
                : `[TDG Portfolio & Services](/en/works-and-services)`;
          } else if (action === 'link-contact') {
            insert =
              state.blogLang === 'id'
                ? `[Hubungi Tim The Digital Grounds](/contact)`
                : `[Contact The Digital Grounds](/en/contact)`;
          }

          textarea.setRangeText(insert, start, end, 'end');
          textarea.focus();
          updateLiveSeoPanel();
        });
      });

      document.getElementById('blog-cover-upload')?.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        try {
          showToast('Mengunggah gambar cover artikel...');
          const url = await uploadMediaFile(file, 'blog');
          (document.getElementById('blog-cover-image') as HTMLInputElement).value = url;
          showToast('Cover artikel berhasil diunggah!');
        } catch (err: any) {
          showToast(err.message, true);
        }
      });

      document.getElementById('blog-inline-image-upload')?.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        const altPrompt = prompt('Masukkan Alt Text deskriptif untuk gambar ini (Wajib untuk SEO):', file.name.replace(/\.[^.]+$/, ''));
        if (altPrompt === null) return;
        try {
          showToast('Mengunggah gambar ke dalam artikel...');
          const url = await uploadMediaFile(file, 'blog');
          const textarea = document.getElementById('blog-content') as HTMLTextAreaElement;
          const mdImg = `\n![${altPrompt || 'Ilustrasi artikel The Digital Grounds'}](${url})\n`;
          textarea.setRangeText(mdImg, textarea.selectionStart, textarea.selectionEnd, 'end');
          updateLiveSeoPanel();
          showToast('Gambar berhasil disisipkan ke artikel!');
        } catch (err: any) {
          showToast(err.message, true);
        }
      });

      document.getElementById('btn-save-blog-article')?.addEventListener('click', async () => {
        readBlogEditorIntoWorking();
        if (!workingArticle.id_lang.title || !workingArticle.id_lang.slug) {
          showToast('Judul dan URL Slug Bahasa Indonesia wajib diisi!', true);
          return;
        }
        // Fallback English fields if user only filled Indonesian first
        if (!workingArticle.en_lang.title) {
          workingArticle.en_lang.title = workingArticle.id_lang.title;
        }
        if (!workingArticle.en_lang.slug) {
          workingArticle.en_lang.slug = `${workingArticle.id_lang.slug}-en`;
        }
        if (!workingArticle.en_lang.seoTitle) {
          workingArticle.en_lang.seoTitle = workingArticle.id_lang.seoTitle || workingArticle.en_lang.title;
        }
        if (!workingArticle.en_lang.seoDescription) {
          workingArticle.en_lang.seoDescription = workingArticle.id_lang.seoDescription || workingArticle.id_lang.excerpt;
        }
        if (!workingArticle.en_lang.excerpt) {
          workingArticle.en_lang.excerpt = workingArticle.id_lang.excerpt;
        }
        if (!workingArticle.en_lang.coverAlt) {
          workingArticle.en_lang.coverAlt = workingArticle.id_lang.coverAlt || workingArticle.en_lang.title;
        }
        if (!workingArticle.en_lang.content) {
          workingArticle.en_lang.content = workingArticle.id_lang.content;
        }

        if (state.editingBlogIndex === -1) {
          state.blog.articles.unshift(workingArticle);
        } else {
          state.blog.articles[state.editingBlogIndex] = workingArticle;
        }

        updateNavCounters();
        renderBlogListTab();
        document.getElementById('blog-editor-view')!.classList.add('hidden');
        document.getElementById('blog-list-view')!.classList.remove('hidden');

        try {
          const msg = await saveResource('blog', state.blog);
          showToast(msg);
        } catch (err: any) {
          showToast(err.message, true);
        }
      });

      // =========================================================
      // GITHUB CONFIG & ONE-CLICK GIT PUSH
      // =========================================================
      const ghModal = document.getElementById('github-config-modal')!;
      document.getElementById('btn-git-settings')?.addEventListener('click', () => {
        const cfg = getGhConfig();
        (document.getElementById('gh-repo-input') as HTMLInputElement).value = cfg.repo;
        (document.getElementById('gh-branch-input') as HTMLInputElement).value = cfg.branch;
        (document.getElementById('gh-token-input') as HTMLInputElement).value = cfg.token;
        ghModal.classList.remove('hidden');
        ghModal.classList.add('flex');
      });

      document.getElementById('btn-close-gh-modal')?.addEventListener('click', () => {
        ghModal.classList.add('hidden');
        ghModal.classList.remove('flex');
      });

      document.getElementById('btn-save-gh-config')?.addEventListener('click', () => {
        const cfg = {
          repo: (document.getElementById('gh-repo-input') as HTMLInputElement).value.trim(),
          branch: (document.getElementById('gh-branch-input') as HTMLInputElement).value.trim(),
          token: (document.getElementById('gh-token-input') as HTMLInputElement).value.trim()
        };
        localStorage.setItem(GH_CONFIG_KEY, JSON.stringify(cfg));
        ghModal.classList.add('hidden');
        ghModal.classList.remove('flex');
        showToast('Konfigurasi GitHub berhasil disimpan!');
      });

      document.getElementById('btn-git-push')?.addEventListener('click', async () => {
        try {
          showToast('Menyinkronkan & melakukan push ke GitHub (tdgcreative)...');
          if (state.mode === 'local') {
            const res = await fetch('/api/admin/git-sync', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ message: 'chore(cms): update website content via TDG Admin' })
            });
            const json = await res.json();
            if (!res.ok || !json.ok) throw new Error(json.error || 'Gagal push ke GitHub');
            showToast(json.message);
          } else {
            await saveResource('home', state.home);
            await saveResource('portfolios', state.portfolios);
            await saveResource('blog', state.blog);
            showToast('Seluruh data berhasil di-commit ke GitHub tdgcreative!');
          }
        } catch (err: any) {
          showToast(err.message || 'Gagal melakukan Git Push', true);
        }
      });
    </script>
  </body>
</html>
