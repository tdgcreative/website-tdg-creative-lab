      function readBlogEditorIntoWorking() {
        if (!workingArticle) return;
        const langKey = state.blogLang === 'id' ? 'id_lang' : 'en_lang';
        const post = workingArticle[langKey];

        workingArticle.category = (document.getElementById('blog-category') as HTMLSelectElement).value;
        workingArticle.publishedAt = (document.getElementById('blog-published-at') as HTMLInputElement).value;
        workingArticle.updatedAt = new Date().toISOString().slice(0, 10);
        workingArticle.status = (document.getElementById('blog-status') as HTMLSelectElement).value;
        workingArticle.featured = (document.getElementById('blog-featured') as HTMLInputElement).checked;
        workingArticle.coverImage = (document.getElementById('blog-cover-image') as HTMLInputElement).value.trim();

        post.focusKeyword = (document.getElementById('blog-focus-keyword') as HTMLInputElement).value.trim();
        post.slug = (document.getElementById('blog-slug') as HTMLInputElement).value
          .toLowerCase()
          .replace(/[^a-z0-9-]+/g, '-')
          .replace(/^-|-$/g, '');
        post.title = (document.getElementById('blog-title') as HTMLInputElement).value.trim();
        post.seoTitle = (document.getElementById('blog-seo-title') as HTMLInputElement).value.trim();
        post.coverAlt = (document.getElementById('blog-cover-alt') as HTMLInputElement).value.trim();
        post.seoDescription = (document.getElementById('blog-seo-desc') as HTMLTextAreaElement).value.trim();
        post.excerpt = (document.getElementById('blog-excerpt') as HTMLTextAreaElement).value.trim();
        post.tags = (document.getElementById('blog-tags') as HTMLInputElement).value
          .split(',')
          .map((t) => t.trim())
          .filter(Boolean);
        post.content = (document.getElementById('blog-content') as HTMLTextAreaElement).value;
      }

      function updateLiveSeoPanel() {
        if (!workingArticle) return;
        readBlogEditorIntoWorking();
        const langKey = state.blogLang === 'id' ? 'id_lang' : 'en_lang';
        const post = workingArticle[langKey];

        const seoTitle = post.seoTitle || post.title || 'Judul Artikel — The Digital Grounds';
        const seoDesc = post.seoDescription || post.excerpt || 'Tulis meta description untuk menampilkan ringkasan di Google...';
        const slugPrefix = state.blogLang === 'id' ? 'blog' : 'en › blog';

        document.getElementById('seo-title-counter')!.textContent = `${seoTitle.length} / 60`;
        document.getElementById('seo-desc-counter')!.textContent = `${seoDesc.length} / 160`;

        document.getElementById('serp-preview-url')!.textContent = `https://www.thedigitalgrounds.com › ${slugPrefix} › ${post.slug || '...'}`;
        document.getElementById('serp-preview-title')!.textContent = seoTitle;
        document.getElementById('serp-preview-desc')!.textContent = seoDesc;

        const { score, checks } = computeArticleSeoScore(post);
        const scoreEl = document.getElementById('seo-score-number')!;
        const circleEl = document.getElementById('seo-score-circle')!;
        scoreEl.textContent = score.toString();

        if (score >= 80) {
          circleEl.className = 'w-14 h-14 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 flex flex-col items-center justify-center text-emerald-400';
        } else if (score >= 55) {
          circleEl.className = 'w-14 h-14 rounded-2xl bg-amber-500/20 border border-amber-500/40 flex flex-col items-center justify-center text-amber-400';
        } else {
          circleEl.className = 'w-14 h-14 rounded-2xl bg-red-500/20 border border-red-500/40 flex flex-col items-center justify-center text-red-400';
        }

        const listEl = document.getElementById('seo-checklist-items')!;
        listEl.innerHTML = checks
          .map(
            (c) => `
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 text-xs ${c.pass ? 'text-emerald-400' : 'text-white/30'}">${c.pass ? '✔' : '○'}</span>
            <span class="${c.pass ? 'text-white/90 font-semibold' : 'text-white/50'} leading-snug">${c.label}</span>
          </li>
        `
          )
          .join('');
      }

