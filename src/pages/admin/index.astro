      let workingArticle: any = null;

      function computeArticleSeoScore(postLang: any) {
        const kw = (postLang.focusKeyword || '').toLowerCase().trim();
        const title = (postLang.title || '').toLowerCase();
        const seoTitle = postLang.seoTitle || postLang.title || '';
        const seoDesc = postLang.seoDescription || postLang.excerpt || '';
        const slug = (postLang.slug || '').toLowerCase();
        const content = postLang.content || '';
        const coverAlt = (postLang.coverAlt || '').trim();

        const firstPara = (content.split('\n\n')[0] || '').toLowerCase();
        const hasH2 = /^##\s+.+/m.test(content);
        const hasInternalLink = /\]\((\/works-and-services|\/contact|\/en\/works-and-services|\/en\/contact|\/blog\/)/i.test(content);

        const checks = [
          {
            label: 'Focus Keyword telah ditentukan',
            pass: kw.length >= 3,
            points: 15
          },
          {
            label: 'Focus Keyword muncul di Judul Utama (H1) atau Meta Title',
            pass: kw.length >= 3 && (title.includes(kw) || seoTitle.toLowerCase().includes(kw)),
            points: 15
          },
          {
            label: `Panjang Meta Title optimal (${seoTitle.length} karakter — ideal 40–65)`,
            pass: seoTitle.length >= 35 && seoTitle.length <= 68,
            points: 15
          },
          {
            label: `Panjang Meta Description optimal (${seoDesc.length} karakter — ideal 110–165)`,
            pass: seoDesc.length >= 100 && seoDesc.length <= 170,
            points: 15
          },
          {
            label: 'URL Slug bersih, deskriptif & huruf kecil',
            pass: /^[a-z0-9-]+$/.test(slug) && slug.length >= 8,
            points: 10
          },
          {
            label: 'Focus Keyword muncul di paragraf pembuka',
            pass: kw.length >= 3 && firstPara.includes(kw),
            points: 10
          },
          {
            label: 'Memiliki struktur Subheading (## H2) untuk Table of Contents',
            pass: hasH2,
            points: 10
          },
          {
            label: 'Alt Text gambar terisi & memiliki Internal Link ke layanan/kontak',
            pass: coverAlt.length >= 10 && hasInternalLink,
            points: 10
          }
        ];

        const score = checks.reduce((sum, c) => sum + (c.pass ? c.points : 0), 0);
        return { score, checks };
      }

