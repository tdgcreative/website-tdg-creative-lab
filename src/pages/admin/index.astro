        document.getElementById('nav-porto-count')!.textContent = String(items.length);
        if (!listEl) return;

        listEl.innerHTML = items
          .map(
            (item: any, idx: number) => `
          <button
            type="button"
            data-porto-idx="${idx}"
            class="w-full flex items-center gap-3 p-3 rounded-2xl border text-left transition-all cursor-pointer ${
              idx === state.selectedPortoIdx
                ? 'bg-[#141414] text-white border-[#141414] shadow-sm'
                : 'bg-white text-[#141414] border-black/10 hover:border-black/30'
            }"
