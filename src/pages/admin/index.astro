---
import '../../styles/global.css';
import initialHome from '../../data/home.json';
import initialPortfolios from '../../data/portfolios.json';
import initialBlog from '../../data/blog.json';

const initialPayload = JSON.stringify({
  home: initialHome,
  portfolios: initialPortfolios,
  blog: initialBlog
});
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TDG Creative Lab — Admin & SEO Studio</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/TDG LOGO TRANSPARENT.png" />
  </head>
  <body class="min-h-screen bg-[#111111] text-white font-sans antialiased selection:bg-brand-orange selection:text-white">
    <!-- LOGIN GATE OVERLAY -->
    <div id="admin-login-gate" class="fixed inset-0 z-50 bg-[#0b0b0b] flex items-center justify-center p-4">
      <div class="w-full max-w-md bg-[#161616] border border-white/10 rounded-3xl p-8 shadow-2xl">
        <div class="flex items-center gap-3 mb-6">
          <img src="/TDG LOGO TRANSPARENT.png" alt="TDG Logo" class="h-10 w-auto invert brightness-0" />
          <div>
            <span class="text-[10px] font-black uppercase tracking-widest text-brand-orange block">Internal System</span>
            <h1 class="text-xl font-black uppercase tracking-tight text-white">TDG Admin & SEO CMS</h1>
          </div>
        </div>

        <p class="text-xs text-white/60 leading-relaxed mb-6">
          Masuk untuk mengelola konten halaman <strong>Home</strong>, <strong>Portofolio</strong>, dan <strong>Artikel Blog SEO Bilingual (ID & EN)</strong>.
        </p>

        <form id="login-form" class="flex flex-col gap-4">
          <div>
            <label for="admin-pass-input" class="block text-[11px] font-bold uppercase tracking-wider text-white/60 mb-1.5">
              Admin Access Code
            </label>
            <input
              id="admin-pass-input"
              type="password"
              required
              placeholder="Masukkan kode akses admin..."
              class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-3 text-sm text-white outline-none transition-colors"
            />
            <span class="text-[11px] text-white/40 mt-1.5 block">Default akses lokal: <code class="text-brand-orange">tdgcreative2026</code></span>
          </div>

          <p id="login-error" class="text-xs font-bold text-red-400 hidden">
            Kode akses tidak sesuai. Silakan coba lagi.
          </p>

          <button
            type="submit"
            class="w-full bg-brand-orange hover:bg-brand-orange-light text-white font-extrabold text-xs uppercase tracking-wider py-3.5 rounded-full transition-all shadow-lg cursor-pointer mt-1"
          >
            Masuk ke Dashboard Admin
          </button>
        </form>
      </div>
    </div>

    <!-- MAIN ADMIN WORKSPACE -->
    <div id="admin-app" class="hidden min-h-screen flex flex-col">
      <!-- Top Navigation Bar -->
      <header class="sticky top-0 z-40 bg-[#141414]/95 backdrop-blur-md border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <a href="/admin" class="flex items-center gap-3">
              <img src="/TDG LOGO TRANSPARENT.png" alt="TDG" class="h-8 sm:h-9 w-auto invert brightness-0" />
              <div class="hidden sm:block">
                <span class="text-[10px] font-black uppercase tracking-widest text-brand-orange block leading-none">CMS & SEO Studio</span>
                <span class="text-sm font-black uppercase tracking-tight text-white">The Digital Grounds</span>
              </div>
            </a>

            <!-- Main Module Tabs -->
            <nav class="flex items-center bg-black/50 p-1 rounded-full border border-white/10 ml-2 sm:ml-6">
              <button
                type="button"
                data-tab="home"
                class="admin-tab-btn px-3.5 sm:px-5 py-1.5 sm:py-2 rounded-full text-xs font-extrabold transition-all cursor-pointer bg-brand-orange text-white"
              >
                🏠 Home Page
              </button>
              <button
                type="button"
                data-tab="portfolios"
                class="admin-tab-btn px-3.5 sm:px-5 py-1.5 sm:py-2 rounded-full text-xs font-extrabold transition-all cursor-pointer text-white/65 hover:text-white"
              >
                💼 Portofolio (<span id="nav-porto-count">0</span>)
              </button>
              <button
                type="button"
                data-tab="blog"
                class="admin-tab-btn px-3.5 sm:px-5 py-1.5 sm:py-2 rounded-full text-xs font-extrabold transition-all cursor-pointer text-white/65 hover:text-white"
              >
                ✍️ Blog & SEO (<span id="nav-blog-count">0</span>)
              </button>
            </nav>
          </div>

          <!-- Right Actions: Mode Indicator, Git Push, Preview Links -->
          <div class="flex items-center gap-2.5">
            <span
              id="storage-mode-badge"
              class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span id="storage-mode-text">Local File Mode</span>
            </span>

            <button
              type="button"
              id="btn-git-settings"
              class="px-3 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-bold text-white/80 transition-colors cursor-pointer"
              title="Konfigurasi GitHub Cloud API (tdgcreative)"
            >
              ⚙️ GitHub Config
            </button>

            <button
              type="button"
              id="btn-git-push"
              class="px-4 py-2 rounded-full bg-white text-black hover:bg-brand-orange hover:text-white text-xs font-black uppercase tracking-wider transition-all cursor-pointer shadow-sm"
            >
              🚀 Push ke GitHub
            </button>

            <a
              href="/"
              target="_blank"
              class="hidden lg:inline-flex items-center gap-1 px-3.5 py-2 rounded-full bg-white/5 hover:bg-white/15 text-xs font-bold text-white/80 transition-colors"
            >
              <span>Lihat Web ↗</span>
            </a>

            <button
              type="button"
              id="btn-logout"
              class="p-2 rounded-xl bg-white/5 hover:bg-red-500/20 text-white/50 hover:text-red-400 text-xs font-bold transition-colors cursor-pointer"
              title="Keluar"
            >
              Keluar
            </button>
          </div>
        </div>
      </header>

      <!-- Toast Notification Banner -->
      <div
        id="admin-toast"
        class="fixed bottom-5 right-5 z-50 max-w-md bg-[#1c1c1c] border border-brand-orange text-white px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3 transform translate-y-24 opacity-0 pointer-events-none transition-all duration-300"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-brand-orange shrink-0"></span>
        <span id="admin-toast-msg" class="text-xs font-bold leading-snug">Berhasil disimpan!</span>
      </div>

      <!-- ========================================================= -->
      <!-- TAB 1: HOME PAGE EDITOR (BILINGUAL ID & EN)               -->
      <!-- ========================================================= -->
      <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-8">
        <section id="tab-panel-home" class="space-y-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-[#181818] p-6 rounded-3xl border border-white/10">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-brand-orange">Modul 01 • Beranda Bilingual</span>
              <h2 class="text-2xl font-black uppercase tracking-tight">Pengaturan Halaman Home (`/` & `/en`)</h2>
              <p class="text-xs text-white/60 mt-1">
                Perbarui headline hero, klaim statistik, logo klien marquee, hingga ruang lingkup layanan untuk Bahasa Indonesia & Inggris.
              </p>
            </div>
            <div class="flex items-center gap-3">
              <!-- Language Toggle for Home Form -->
              <div class="flex bg-black p-1 rounded-full border border-white/10">
                <button
                  type="button"
                  data-home-lang="id"
                  class="home-lang-btn px-3.5 py-1.5 rounded-full text-xs font-extrabold bg-brand-orange text-white cursor-pointer"
                >
                  🇮🇩 ID
                </button>
                <button
                  type="button"
                  data-home-lang="en"
                  class="home-lang-btn px-3.5 py-1.5 rounded-full text-xs font-extrabold text-white/60 hover:text-white cursor-pointer"
                >
                  🇬🇧 EN
                </button>
              </div>

              <button
                type="button"
                id="btn-save-home"
                class="bg-brand-orange hover:bg-brand-orange-light text-white font-black text-xs uppercase tracking-wider px-6 py-3 rounded-full shadow-lg transition-all cursor-pointer"
              >
                💾 Simpan Perubahan Home
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left Column: SEO, Hero, Pitch -->
            <div class="lg:col-span-7 space-y-6">
              <!-- SEO Metadata Card -->
              <div class="bg-[#181818] p-6 rounded-3xl border border-white/10 space-y-4">
                <div class="flex items-center justify-between">
                  <h3 class="text-sm font-black uppercase tracking-wider text-brand-orange">1. Meta SEO Beranda (<span class="home-active-lang-label">ID</span>)</h3>
                  <span class="text-[11px] text-white/45">Tampil di hasil pencarian Google</span>
                </div>
                <div>
                  <label class="block text-xs font-bold text-white/70 mb-1">Meta Title (Tag Title)</label>
                  <input id="home-seo-title" type="text" class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-2.5 text-sm text-white outline-none" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-white/70 mb-1">Meta Description</label>
                  <textarea id="home-seo-desc" rows="2" class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-2.5 text-sm text-white outline-none"></textarea>
                </div>
              </div>

              <!-- Hero Section Card -->
              <div class="bg-[#181818] p-6 rounded-3xl border border-white/10 space-y-4">
                <h3 class="text-sm font-black uppercase tracking-wider text-brand-orange">2. Hero Section (<span class="home-active-lang-label">ID</span>)</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-white/70 mb-1">Headline Utama (Besar)</label>
                    <input id="home-hero-main" type="text" class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-2.5 text-sm text-white outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-white/70 mb-1">Sub-Headline Kedua</label>
                    <input id="home-hero-sub" type="text" class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-2.5 text-sm text-white outline-none" />
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-bold text-white/70 mb-1">Deskripsi Subheadline (<span class="home-active-lang-label">ID</span>)</label>
                  <input id="home-hero-desc" type="text" class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-2.5 text-sm text-white outline-none" />
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-white/70 mb-1">Teks Tombol Utama (CTA)</label>
                    <input id="home-hero-cta1" type="text" class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-2.5 text-sm text-white outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-white/70 mb-1">Teks Tombol Kedua</label>
                    <input id="home-hero-cta2" type="text" class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-2.5 text-sm text-white outline-none" />
                  </div>
                </div>
              </div>

              <!-- Core Pitch & Stats Card -->
              <div class="bg-[#181818] p-6 rounded-3xl border border-white/10 space-y-4">
                <h3 class="text-sm font-black uppercase tracking-wider text-brand-orange">3. Core Pitch & Statistik (<span class="home-active-lang-label">ID</span>)</h3>
                <div>
                  <label class="block text-xs font-bold text-white/70 mb-1">Judul Core Pitch</label>
                  <input id="home-pitch-title" type="text" class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-2.5 text-sm text-white outline-none" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-white/70 mb-1">Paragraf Core Pitch (<span class="home-active-lang-label">ID</span>)</label>
                  <textarea id="home-pitch-desc" rows="3" class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-2.5 text-sm text-white outline-none"></textarea>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
                  <div>
                    <label class="block text-[11px] font-bold text-white/60 mb-1">Stat 1 (Angka)</label>
                    <input id="home-stat1-val" type="text" class="w-full bg-black/60 border border-white/15 rounded-xl px-3 py-2 text-sm text-brand-orange font-black outline-none" />
                  </div>
                  <div>
                    <label class="block text-[11px] font-bold text-white/60 mb-1">Stat 1 (Label)</label>
                    <input id="home-stat1-label" type="text" class="w-full bg-black/60 border border-white/15 rounded-xl px-3 py-2 text-sm text-white outline-none" />
                  </div>
                  <div>
                    <label class="block text-[11px] font-bold text-white/60 mb-1">Stat 2 (Angka)</label>
                    <input id="home-stat2-val" type="text" class="w-full bg-black/60 border border-white/15 rounded-xl px-3 py-2 text-sm text-brand-orange font-black outline-none" />
                  </div>
                  <div>
                    <label class="block text-[11px] font-bold text-white/60 mb-1">Stat 2 (Label)</label>
                    <input id="home-stat2-label" type="text" class="w-full bg-black/60 border border-white/15 rounded-xl px-3 py-2 text-sm text-white outline-none" />
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-bold text-white/70 mb-1">Spesialisasi Industri (Pisahkan dengan koma)</label>
                  <input id="home-industries-input" type="text" class="w-full bg-black/60 border border-white/15 focus:border-brand-orange rounded-xl px-4 py-2.5 text-sm text-white outline-none" />
                </div>
              </div>

              <!-- Service Scopes Editor -->
              <div class="bg-[#181818] p-6 rounded-3xl border border-white/10 space-y-4">
                <h3 class="text-sm font-black uppercase tracking-wider text-brand-orange">4. Ruang Lingkup Layanan (Scopes 01–04)</h3>
                <div id="home-scopes-container" class="space-y-4">
                  <!-- Populated dynamically via JS -->
                </div>
              </div>
            </div>

            <!-- Right Column: Client Logos Marquee & Featured Home Portfolios -->
            <div class="lg:col-span-5 space-y-6">
              <!-- Featured Portfolios on Home -->
              <div class="bg-[#181818] p-6 rounded-3xl border border-white/10 space-y-4">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-sm font-black uppercase tracking-wider text-brand-orange">5. Portofolio Unggulan di Home</h3>
                    <p class="text-[11px] text-white/55 mt-0.5">Pilih proyek yang ditampilkan pada seksi "Some of Our Works" di halaman Beranda.</p>
                  </div>
                </div>
                <div id="home-featured-portfolios-list" class="space-y-2 max-h-80 overflow-y-auto pr-1">
                  <!-- Populated via JS -->
                </div>
              </div>

              <!-- Client Logos Marquee Manager -->
              <div class="bg-[#181818] p-6 rounded-3xl border border-white/10 space-y-4">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-sm font-black uppercase tracking-wider text-brand-orange">6. Logo Klien (Marquee)</h3>
                    <p class="text-[11px] text-white/55 mt-0.5">Kelola barisan logo brand yang berjalan di bawah Hero.</p>
                  </div>
                  <label class="bg-white/10 hover:bg-brand-orange text-white text-xs font-extrabold px-3.5 py-2 rounded-full cursor-pointer transition-colors">
                    <span>+ Upload Logo</span>
                    <input id="upload-logo-input" type="file" accept="image/*" class="hidden" />
                  </label>
                </div>

                <div id="home-logos-list" class="space-y-2.5 max-h-[420px] overflow-y-auto pr-1">
                  <!-- Populated via JS -->
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ========================================================= -->
        <!-- TAB 2: PORTFOLIO MANAGER                                  -->
        <!-- ========================================================= -->
        <section id="tab-panel-portfolios" class="hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-[#181818] p-6 rounded-3xl border border-white/10">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-brand-orange">Modul 02 • Case Studies & Deliverables</span>
              <h2 class="text-2xl font-black uppercase tracking-tight">Manajemen Portofolio (`works-and-services`)</h2>
              <p class="text-xs text-white/60 mt-1">
                Tambah proyek baru, kelola deskripsi studi kasus bilingual (ID & EN), dan atur foto, video reels, maupun PDF brandbook/menubook.
              </p>
            </div>
            <button
              type="button"
              id="btn-new-portfolio"
              class="bg-brand-orange hover:bg-brand-orange-light text-white font-black text-xs uppercase tracking-wider px-6 py-3.5 rounded-full shadow-lg transition-all cursor-pointer shrink-0"
            >
              ➕ Tambah Portofolio Baru
            </button>
          </div>

          <!-- Filter & Search Bar -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
            <div class="flex flex-wrap gap-2">
              <button type="button" data-porto-filter="all" class="porto-admin-filter px-4 py-2 rounded-full text-xs font-bold bg-brand-orange text-white cursor-pointer">
                Semua Proyek
              </button>
              <button type="button" data-porto-filter="content-media" class="porto-admin-filter px-4 py-2 rounded-full text-xs font-bold bg-[#181818] text-white/70 hover:text-white border border-white/10 cursor-pointer">
                Content & Media
              </button>
              <button type="button" data-porto-filter="brand-digital" class="porto-admin-filter px-4 py-2 rounded-full text-xs font-bold bg-[#181818] text-white/70 hover:text-white border border-white/10 cursor-pointer">
                Brand & Digital
              </button>
              <button type="button" data-porto-filter="visual-doc" class="porto-admin-filter px-4 py-2 rounded-full text-xs font-bold bg-[#181818] text-white/70 hover:text-white border border-white/10 cursor-pointer">
                Visual Production
              </button>
            </div>

            <input
              id="porto-search-input"
              type="search"
              placeholder="Cari nama klien atau tag..."
              class="bg-[#181818] border border-white/15 focus:border-brand-orange rounded-full px-4 py-2 text-xs text-white outline-none w-full sm:w-64"
            />
          </div>

          <!-- Portfolio Cards Grid -->
          <div id="admin-portfolios-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <!-- Injected via JS -->
          </div>
        </section>

        <!-- ========================================================= -->
        <!-- TAB 3: SEO BLOG STUDIO                                    -->
        <!-- ========================================================= -->
        <section id="tab-panel-blog" class="hidden space-y-6">
          <!-- Blog List View -->
          <div id="blog-list-view" class="space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-[#181818] p-6 rounded-3xl border border-white/10">
              <div>
                <span class="text-[10px] font-black uppercase tracking-widest text-brand-orange">Modul 03 • Content Marketing & Technical SEO</span>
                <h2 class="text-2xl font-black uppercase tracking-tight">Artikel Blog & Asisten SEO (`/blog` & `/en/blog`)</h2>
                <p class="text-xs text-white/60 mt-1">
                  Tulis artikel ramah mesin pencari Google lengkap dengan JSON-LD Schema otomatis, Daftar Isi (ToC), `hreflang` ID-EN, dan skor audit SEO real-time.
                </p>
              </div>
              <button
                type="button"
                id="btn-new-blog"
                class="bg-brand-orange hover:bg-brand-orange-light text-white font-black text-xs uppercase tracking-wider px-6 py-3.5 rounded-full shadow-lg transition-all cursor-pointer shrink-0"
              >
                ✍️ Tulis Artikel Baru
              </button>
            </div>

            <div id="admin-blog-list" class="grid grid-cols-1 gap-4">
              <!-- Injected via JS -->
            </div>
          </div>

          <!-- Blog Editor + Real-time SEO Studio View -->
          <div id="blog-editor-view" class="hidden space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-4 bg-[#181818] p-5 rounded-3xl border border-white/10">
              <div class="flex items-center gap-3">
                <button
                  type="button"
                  id="btn-back-blog-list"
                  class="px-4 py-2 rounded-full bg-white/5 hover:bg-white/15 text-xs font-bold text-white transition-colors cursor-pointer"
                >
                  ← Kembali ke Daftar
                </button>
                <div>
                  <span class="text-[10px] font-black uppercase tracking-widest text-brand-orange block">Live SEO Editor</span>
                  <h3 id="blog-editor-heading" class="text-lg font-black uppercase tracking-tight">Edit Artikel Blog</h3>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <!-- Language Switcher inside Blog Editor -->
                <div class="flex bg-black p-1 rounded-full border border-white/10">
                  <button
                    type="button"
                    data-blog-lang="id"
                    class="blog-lang-btn px-4 py-1.5 rounded-full text-xs font-extrabold bg-brand-orange text-white cursor-pointer"
                  >
                    🇮🇩 Bahasa Indonesia
                  </button>
                  <button
                    type="button"
                    data-blog-lang="en"
                    class="blog-lang-btn px-4 py-1.5 rounded-full text-xs font-extrabold text-white/60 hover:text-white cursor-pointer"
                  >
                    🇬🇧 English Version
                  </button>
                </div>

                <button
                  type="button"
                  id="btn-save-blog-article"
                  class="bg-brand-orange hover:bg-brand-orange-light text-white font-black text-xs uppercase tracking-wider px-6 py-3 rounded-full shadow-lg transition-all cursor-pointer"
                >
                  💾 Simpan & Publikasikan Artikel
                </button>
              </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
              <!-- Left 8 Cols: Content & Metadata Form -->
              <div class="lg:col-span-8 space-y-6">
                <!-- Shared Article Settings -->
                <div class="bg-[#181818] p-6 rounded-3xl border border-white/10 space-y-4">
                  <h4 class="text-xs font-black uppercase tracking-wider text-brand-orange">Pengaturan Umum & Gambar Cover</h4>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                      <label class="block text-[11px] font-bold text-white/70 mb-1">Kategori Topik</label>
                      <select id="blog-category" class="w-full bg-black/60 border border-white/15 rounded-xl px-3.5 py-2.5 text-xs text-white outline-none">
                        <option value="Content & Media Management">Content & Media Management</option>
                        <option value="Brand & Digital Foundation">Brand & Digital Foundation</option>
