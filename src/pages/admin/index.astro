        listEl.querySelectorAll<HTMLButtonElement>('[data-blog-idx]').forEach((btn) => {
          btn.addEventListener('click', () => {
            readBlogForm();
            state.selectedBlogIdx = Number(btn.dataset.blogIdx);
            renderBlogSidebarList();
            populateBlogForm();
          });
        });
      }

      function populateBlogForm() {
        renderBlogSidebarList();
        const art = state.blog.articles?.[state.selectedBlogIdx];
        if (!art) return;
        const langKey = state.editLang === 'id' ? 'id_lang' : 'en_lang';
        if (!art[langKey]) art[langKey] = { slug: '', title: '', excerpt: '', content: '', tags: [] };
        const post = art[langKey];

        document.getElementById('blog-slug-prefix')!.textContent = state.editLang === 'id' ? '/blog/' : '/en/blog/';
        (document.getElementById('blog-title') as HTMLInputElement).value = post.title || '';
        (document.getElementById('blog-slug') as HTMLInputElement).value = post.slug || '';
        (document.getElementById('blog-category') as HTMLSelectElement).value = art.category || 'Content & Media Management';
        (document.getElementById('blog-published-at') as HTMLInputElement).value = art.publishedAt || new Date().toISOString().slice(0, 10);
        (document.getElementById('blog-status') as HTMLSelectElement).value = art.status || 'published';
        (document.getElementById('blog-featured') as HTMLInputElement).checked = Boolean(art.featured);

        (document.getElementById('blog-cover-image') as HTMLInputElement).value = art.coverImage || '';
        (document.getElementById('blog-cover-preview') as HTMLImageElement).src = art.coverImage || '/images/portfolio/fame.jpg';
        (document.getElementById('blog-cover-alt') as HTMLInputElement).value = post.coverAlt || '';

        (document.getElementById('blog-excerpt') as HTMLTextAreaElement).value = post.excerpt || '';
        (document.getElementById('blog-content') as HTMLTextAreaElement).value = post.content || '';
        (document.getElementById('blog-focus-keyword') as HTMLInputElement).value = post.focusKeyword || '';
        (document.getElementById('blog-tags') as HTMLInputElement).value = (post.tags || []).join(', ');
        (document.getElementById('blog-seo-title') as HTMLInputElement).value = post.seoTitle || '';
        (document.getElementById('blog-seo-desc') as HTMLInputElement).value = post.seoDescription || '';

        const liveLink = document.getElementById('btn-view-live-article') as HTMLAnchorElement;
        if (liveLink) {
          liveLink.href = state.editLang === 'id' ? `/blog/${post.slug || ''}` : `/en/blog/${post.slug || ''}`;
        }
      }

      function readBlogForm() {
        const art = state.blog.articles?.[state.selectedBlogIdx];
        if (!art) return;
        const langKey = state.editLang === 'id' ? 'id_lang' : 'en_lang';
        if (!art[langKey]) art[langKey] = {};
        const post = art[langKey];

        post.title = (document.getElementById('blog-title') as HTMLInputElement).value.trim();
        post.slug = slugify((document.getElementById('blog-slug') as HTMLInputElement).value || post.title || `artikel-${Date.now()}`);
        art.category = (document.getElementById('blog-category') as HTMLSelectElement).value;
        art.publishedAt = (document.getElementById('blog-published-at') as HTMLInputElement).value;
        art.updatedAt = new Date().toISOString().slice(0, 10);
        art.status = (document.getElementById('blog-status') as HTMLSelectElement).value;

        const isFeat = (document.getElementById('blog-featured') as HTMLInputElement).checked;
        if (isFeat) {
          state.blog.articles.forEach((a: any, i: number) => {
            a.featured = i === state.selectedBlogIdx;
          });
        } else {
          art.featured = false;
        }

        art.coverImage = (document.getElementById('blog-cover-image') as HTMLInputElement).value.trim() || '/images/portfolio/fame.jpg';
        post.coverAlt = (document.getElementById('blog-cover-alt') as HTMLInputElement).value.trim() || post.title;
        post.excerpt = (document.getElementById('blog-excerpt') as HTMLTextAreaElement).value.trim();
        post.content = (document.getElementById('blog-content') as HTMLTextAreaElement).value;
        post.focusKeyword = (document.getElementById('blog-focus-keyword') as HTMLInputElement).value.trim();
        post.tags = (document.getElementById('blog-tags') as HTMLInputElement).value
          .split(',')
          .map((t) => t.trim())
          .filter(Boolean);
        post.seoTitle = (document.getElementById('blog-seo-title') as HTMLInputElement).value.trim() || `${post.title} — TDG`;
        post.seoDescription = (document.getElementById('blog-seo-desc') as HTMLInputElement).value.trim() || post.excerpt;

        // Auto-fill other language if completely empty so bilingual routes never break
        const otherKey = langKey === 'id_lang' ? 'en_lang' : 'id_lang';
        if (!art[otherKey]?.title && post.title) {
          art[otherKey] = {
            slug: post.slug,
            title: post.title,
            seoTitle: post.seoTitle,
            seoDescription: post.seoDescription,
            focusKeyword: post.focusKeyword,
            coverAlt: post.coverAlt,
            excerpt: post.excerpt,
            tags: [...(post.tags || [])],
            content: post.content,
          };
        }
      }

      document.getElementById('blog-title')?.addEventListener('input', (e) => {
        const titleVal = (e.target as HTMLInputElement).value;
        const slugInput = document.getElementById('blog-slug') as HTMLInputElement;
        if (!slugInput.value || slugInput.value.startsWith('artikel-baru')) {
          slugInput.value = slugify(titleVal);
        }
      });

      document.getElementById('blog-cover-image')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value.trim();
        (document.getElementById('blog-cover-preview') as HTMLImageElement).src = val || '/images/portfolio/fame.jpg';
      });

      document.getElementById('blog-cover-upload')?.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        const url = await handleFileUpload(file, 'blog');
        (document.getElementById('blog-cover-image') as HTMLInputElement).value = url;
        (document.getElementById('blog-cover-preview') as HTMLImageElement).src = url;
        readBlogForm();
        renderBlogSidebarList();
      });

      document.getElementById('blog-inline-image-upload')?.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        const url = await handleFileUpload(file, 'blog');
        const textarea = document.getElementById('blog-content') as HTMLTextAreaElement;
        const alt = file.name.replace(/\.[^.]+$/, '');
        const mdImg = `\n![${alt}](${url})\n`;
        const pos = textarea.selectionStart || textarea.value.length;
        textarea.value = textarea.value.slice(0, pos) + mdImg + textarea.value.slice(pos);
        readBlogForm();
      });

      document.querySelectorAll('.md-tool-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-md-action');
          const ta = document.getElementById('blog-content') as HTMLTextAreaElement;
          const start = ta.selectionStart || 0;
          const end = ta.selectionEnd || 0;
          const sel = ta.value.slice(start, end) || 'Teks';
          let insert = '';
          if (action === 'h2') insert = `\n## ${sel}\n`;
          if (action === 'h3') insert = `\n### ${sel}\n`;
          if (action === 'bold') insert = `**${sel}**`;
          if (action === 'list') insert = `\n- ${sel}\n`;
          ta.value = ta.value.slice(0, start) + insert + ta.value.slice(end);
          readBlogForm();
        });
      });

      document.getElementById('btn-new-article')?.addEventListener('click', async () => {
        readBlogForm();
        const today = new Date().toISOString().slice(0, 10);
        const slugBase = `artikel-baru-${Date.now().toString().slice(-4)}`;
        state.blog.articles.unshift({
          id: `post-${Date.now()}`,
          category: 'Content & Media Management',
          coverImage: '/images/portfolio/aio.png',
          author: 'The Digital Grounds Team',
          publishedAt: today,
          updatedAt: today,
          featured: false,
          status: 'published',
          id_lang: {
            slug: slugBase,
            title: 'Judul Artikel Baru',
            seoTitle: 'Judul Artikel Baru — TDG',
            seoDescription: 'Ringkasan artikel baru.',
            focusKeyword: 'strategi digital marketing',
            coverAlt: 'Cover Artikel The Digital Grounds',
            excerpt: 'Tulis ringkasan singkat artikel di sini...',
            tags: ['Digital Strategy'],
            content: 'Tulis pembahasan artikel Anda di sini...\n\n## Subjudul Pembahasan\n\nJelaskan poin-poin penting secara terstruktur.',
          },
          en_lang: {
            slug: slugBase,
            title: 'New Article Title',
            seoTitle: 'New Article Title — TDG',
            seoDescription: 'Summary of the new article.',
            focusKeyword: 'digital marketing strategy',
            coverAlt: 'The Digital Grounds Article Cover',
            excerpt: 'Write a short summary of the article here...',
            tags: ['Digital Strategy'],
            content: 'Write your article content here...\n\n## Section Heading\n\nExplain key takeaways clearly.',
          },
        });
        state.selectedBlogIdx = 0;
        populateBlogForm();
        await saveAllChanges(false);
        showToast('Artikel baru dibuat & disimpan ke Supabase!');
      });

      document.getElementById('btn-delete-article')?.addEventListener('click', async () => {
        if (!confirm('Hapus artikel blog ini dari Supabase?')) return;
        state.blog.articles.splice(state.selectedBlogIdx, 1);
        state.selectedBlogIdx = 0;
        populateBlogForm();
        await saveAllChanges(false);
        showToast('Artikel berhasil dihapus dari Supabase.');
      });

      document.getElementById('btn-save-blog-inline')?.addEventListener('click', () => saveAllChanges(false));

      // =========================================================
      // PANEL 5: WHATSAPP GLOBAL LOGIC
      // =========================================================
      function updateWaPreview() {
        const rawNum = (document.getElementById('wa-number-input') as HTMLInputElement).value.replace(/[^0-9]/g, '');
        const msgId = (document.getElementById('wa-msg-id') as HTMLTextAreaElement).value.trim();
        const url = `https://wa.me/${rawNum}${msgId ? '?text=' + encodeURIComponent(msgId) : ''}`;
        document.getElementById('wa-preview-url')!.textContent = url;
        (document.getElementById('wa-test-btn') as HTMLAnchorElement).href = url;
      }

      function populateWhatsappForm() {
        const wa = state.settings.whatsapp || {};
        (document.getElementById('wa-number-input') as HTMLInputElement).value = wa.number || '628138238837';
        (document.getElementById('wa-display-input') as HTMLInputElement).value = wa.display || '+62 813-8238-837';
        (document.getElementById('wa-msg-id') as HTMLTextAreaElement).value = wa.defaultMessage?.id || '';
        (document.getElementById('wa-msg-en') as HTMLTextAreaElement).value = wa.defaultMessage?.en || '';
        updateWaPreview();
      }

      function readWhatsappForm() {
        if (!state.settings.whatsapp) state.settings.whatsapp = { defaultMessage: {} };
        state.settings.whatsapp.number = (document.getElementById('wa-number-input') as HTMLInputElement).value.replace(/[^0-9]/g, '');
        state.settings.whatsapp.display = (document.getElementById('wa-display-input') as HTMLInputElement).value.trim();
        if (!state.settings.whatsapp.defaultMessage) state.settings.whatsapp.defaultMessage = {};
        state.settings.whatsapp.defaultMessage.id = (document.getElementById('wa-msg-id') as HTMLTextAreaElement).value.trim();
        state.settings.whatsapp.defaultMessage.en = (document.getElementById('wa-msg-en') as HTMLTextAreaElement).value.trim();
      }

      document.getElementById('wa-number-input')?.addEventListener('input', updateWaPreview);
      document.getElementById('wa-msg-id')?.addEventListener('input', updateWaPreview);

      // =========================================================
      // PANEL 6: TRACKING PIXEL & GTM LOGIC
      // =========================================================
      function updateTrackingBadges() {
        const metaVal = (document.getElementById('tracking-meta-pixel') as HTMLInputElement).value.trim();
        const gtmVal = (document.getElementById('tracking-gtm-id') as HTMLInputElement).value.trim();
        const metaBadge = document.getElementById('meta-pixel-badge')!;
        const gtmBadge = document.getElementById('gtm-badge')!;

        if (metaVal) {
          metaBadge.textContent = 'Aktif Terpasang';
          metaBadge.className = 'text-[10px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700';
        } else {
          metaBadge.textContent = 'Belum Diisi';
          metaBadge.className = 'text-[10px] font-semibold px-2.5 py-0.5 rounded-full bg-black/10 text-black/60';
        }

        if (gtmVal) {
          gtmBadge.textContent = 'Aktif Terpasang';
          gtmBadge.className = 'text-[10px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700';
        } else {
          gtmBadge.textContent = 'Belum Diisi';
          gtmBadge.className = 'text-[10px] font-semibold px-2.5 py-0.5 rounded-full bg-black/10 text-black/60';
        }
      }

      function populateTrackingForm() {
        const tr = state.settings.tracking || {};
        (document.getElementById('tracking-meta-pixel') as HTMLInputElement).value = tr.metaPixelId || '';
        (document.getElementById('tracking-gtm-id') as HTMLInputElement).value = tr.gtmId || '';
        (document.getElementById('tracking-custom-head') as HTMLTextAreaElement).value = tr.customHeadScript || '';
        (document.getElementById('tracking-custom-body') as HTMLTextAreaElement).value = tr.customBodyScript || '';
        updateTrackingBadges();
      }

      function readTrackingForm() {
        if (!state.settings.tracking) state.settings.tracking = {};
        state.settings.tracking.metaPixelId = (document.getElementById('tracking-meta-pixel') as HTMLInputElement).value.trim();
        state.settings.tracking.gtmId = (document.getElementById('tracking-gtm-id') as HTMLInputElement).value.trim();
        state.settings.tracking.customHeadScript = (document.getElementById('tracking-custom-head') as HTMLTextAreaElement).value.trim();
        state.settings.tracking.customBodyScript = (document.getElementById('tracking-custom-body') as HTMLTextAreaElement).value.trim();
      }

      document.getElementById('tracking-meta-pixel')?.addEventListener('input', updateTrackingBadges);
      document.getElementById('tracking-gtm-id')?.addEventListener('input', updateTrackingBadges);

      // =========================================================
      // PANEL 7: SUPABASE CONFIG LOGIC
      // =========================================================
      function populateSupabaseForm() {
        (document.getElementById('supa-url-input') as HTMLInputElement).value = state.supabaseConfig.url || '';
        (document.getElementById('supa-key-input') as HTMLInputElement).value = state.supabaseConfig.key || '';
      }

      function readSupabaseForm() {
        const url = (document.getElementById('supa-url-input') as HTMLInputElement).value.trim();
        const key = (document.getElementById('supa-key-input') as HTMLInputElement).value.trim();
        if (url && key) {
          state.supabaseConfig = { url, key };
          localStorage.setItem('tdg_supabase_config', JSON.stringify({ url, key }));
          resetSupabaseClient();
        }
      }

      document.getElementById('btn-copy-sql')?.addEventListener('click', () => {
        const sql = document.getElementById('sql-schema-box')?.textContent || '';
        navigator.clipboard.writeText(sql);
        showToast('SQL Schema disalin ke clipboard!');
      });

      document.getElementById('btn-test-supabase')?.addEventListener('click', async () => {
        readSupabaseForm();
        await saveAllChanges(true);
      });

      // =========================================================
      // MASTER POPULATE / READ / SAVE (SUPABASE + LOCAL)
      // =========================================================
      function populateCurrentPanel() {
        if (state.activePanel === 'home') populateHomeForm();
        if (state.activePanel === 'portfolios') populatePortfolioForm();
        if (state.activePanel === 'contact') populateContactForm();
        if (state.activePanel === 'blog') populateBlogForm();
        if (state.activePanel === 'whatsapp') populateWhatsappForm();
        if (state.activePanel === 'tracking') populateTrackingForm();
        if (state.activePanel === 'supabase') populateSupabaseForm();
      }

      function readCurrentPanelIntoState() {
        if (state.activePanel === 'home') readHomeForm();
        if (state.activePanel === 'portfolios') readPortfolioForm();
        if (state.activePanel === 'contact') readContactForm();
        if (state.activePanel === 'blog') readBlogForm();
        if (state.activePanel === 'whatsapp') readWhatsappForm();
        if (state.activePanel === 'tracking') readTrackingForm();
        if (state.activePanel === 'supabase') readSupabaseForm();
      }

      async function saveAllChanges(forceSyncAll = false) {
        readCurrentPanelIntoState();

        // 1. Save to localStorage for instant client preview
        localStorage.setItem(
          STATE_STORAGE_KEY,
          JSON.stringify({
            home: state.home,
            portfolios: state.portfolios,
            blog: state.blog,
            settings: state.settings,
          })
        );

        // 2. Save to local Vite dev server files (if running in local dev)
        try {
          await Promise.all([
            fetch('/api/admin/home', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(state.home) }),
            fetch('/api/admin/portfolios', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(state.portfolios) }),
            fetch('/api/admin/blog', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(state.blog) }),
            fetch('/api/admin/settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(state.settings) }),
          ]);
        } catch {}

        // 3. Save to Supabase Cloud Database
        showToast('Menyimpan ke Supabase...');
        const [blogRes, settingsRes, homeRes, portoRes] = await Promise.all([
          syncBlogToSupabase(state.blog),
          saveSiteSettingToSupabase('settings', state.settings),
          saveSiteSettingToSupabase('home', state.home),
          saveSiteSettingToSupabase('portfolios', state.portfolios),
        ]);

        const banner = document.getElementById('supabase-connection-banner');
        if (blogRes.ok && settingsRes.ok) {
          document.getElementById('storage-mode-text')!.textContent = 'Tersimpan di Supabase';
          if (banner) {
            banner.className = 'p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-xs font-semibold text-emerald-800';
            banner.textContent = 'Terhubung & Tersinkronisasi dengan Supabase (cpvbgcdgmyfgnwcvrwxq)';
          }
          showToast(forceSyncAll ? 'Seluruh data berhasil disinkronkan ke Supabase!' : 'Perubahan berhasil disimpan!');
        } else {
          const errMsg = blogRes.error || settingsRes.error || homeRes.error || portoRes.error || '';
          if (banner) {
            banner.className = 'p-4 rounded-2xl bg-amber-50 border border-amber-200 text-xs font-semibold text-amber-800';
            banner.textContent = `Catatan Supabase: ${errMsg}. Pastikan SQL Schema di bawah sudah dijalankan di SQL Editor Supabase.`;
          }
          showToast('Tersimpan di lokal! (Jalankan SQL Schema di menu Database Supabase jika tabel belum dibuat)');
        }

        populateCurrentPanel();
      }

      document.getElementById('btn-primary-save')?.addEventListener('click', () => saveAllChanges(false));
      document.getElementById('btn-save-all-top')?.addEventListener('click', () => saveAllChanges(false));

      // Initialize Workspace & Fetch latest from Supabase
      async function initWorkspace() {
        document.getElementById('nav-porto-count')!.textContent = String((state.portfolios.items || []).length);
        document.getElementById('nav-blog-count')!.textContent = String((state.blog.articles || []).length);
        populateCurrentPanel();

        // Fetch latest state from Supabase
        const remote = await fetchAllSupabaseState();
        if (remote) {
          if (remote.settings) state.settings = { ...state.settings, ...remote.settings };
          if (remote.home) state.home = remote.home;
          if (remote.portfolios) state.portfolios = remote.portfolios;
          if (remote.blog?.articles?.length) {
            state.blog = remote.blog;
            document.getElementById('nav-blog-count')!.textContent = String(state.blog.articles.length);
          } else {
            // Seed initial blog articles to Supabase if table is currently empty
            await syncBlogToSupabase(state.blog);
          }
          populateCurrentPanel();
        } else {
          // First time initialization: seed initial data to Supabase
          await saveAllChanges(true);
        }
      }

      // Check URL hash if user navigated to #blog etc.
      const hash = window.location.hash.replace('#', '');
      if (['home', 'portfolios', 'contact', 'blog', 'whatsapp', 'tracking', 'supabase'].includes(hash)) {
        state.activePanel = hash as any;
      }

      checkAuth();
    </script>
  </body>
</html>
