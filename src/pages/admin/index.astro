      function renderDeliverables() {
        const container = document.getElementById('porto-deliverables-list');
        const item = state.portfolios.items?.[state.selectedPortoIdx];
        if (!container || !item) return;
        const outputs = item.outputs || [];

        container.innerHTML = outputs
          .map(
            (out: any, idx: number) => `
          <div class="p-3.5 rounded-xl bg-[#F9F9F8] border border-black/10 space-y-2">
            <div class="flex items-center justify-between gap-2">
              <select data-out-type="${idx}" class="bg-white border border-black/15 rounded-lg px-2.5 py-1 text-xs font-semibold outline-none">
                <option value="image" ${out.type === 'image' ? 'selected' : ''}>Foto / Gambar</option>
                <option value="video" ${out.type === 'video' ? 'selected' : ''}>Video MP4</option>
                <option value="pdf" ${out.type === 'pdf' ? 'selected' : ''}>Dokumen PDF</option>
                <option value="link" ${out.type === 'link' ? 'selected' : ''}>External Website</option>
              </select>
              <input data-out-label="${idx}" type="text" value="${out.label || ''}" placeholder="Judul Deliverable" class="flex-1 bg-white border border-black/15 rounded-lg px-2.5 py-1 text-xs font-semibold outline-none" />
              <button type="button" data-out-del="${idx}" class="text-red-500 hover:text-red-700 text-[11px] font-semibold px-1.5 cursor-pointer">Hapus</button>
            </div>
            <div class="flex items-center gap-2">
              <input data-out-url="${idx}" type="text" value="${out.url || ''}" placeholder="URL File / Gambar..." class="flex-1 bg-white border border-black/15 rounded-lg px-2.5 py-1 text-xs outline-none" />
              <label class="px-2.5 py-1 rounded-lg bg-[#141414] hover:bg-brand-orange text-white text-[11px] font-semibold cursor-pointer shrink-0">
                Upload File
                <input data-out-upload="${idx}" type="file" class="hidden" />
              </label>
            </div>
          </div>
        `
          )
          .join('');

        container.querySelectorAll<HTMLSelectElement>('[data-out-type]').forEach((sel) => {
          sel.addEventListener('change', () => {
            item.outputs[Number(sel.dataset.outType)].type = sel.value;
          });
        });
        container.querySelectorAll<HTMLInputElement>('[data-out-label]').forEach((inp) => {
          inp.addEventListener('input', () => {
            item.outputs[Number(inp.dataset.outLabel)].label = inp.value;
          });
        });
        container.querySelectorAll<HTMLInputElement>('[data-out-url]').forEach((inp) => {
          inp.addEventListener('input', () => {
            item.outputs[Number(inp.dataset.outUrl)].url = inp.value;
          });
        });
        container.querySelectorAll<HTMLInputElement>('[data-out-upload]').forEach((inp) => {
          inp.addEventListener('change', async () => {
            const file = inp.files?.[0];
            if (!file) return;
            const i = Number(inp.dataset.outUpload);
            const url = await handleFileUpload(file, 'portfolio');
            item.outputs[i].url = url;
            renderDeliverables();
          });
        });
        container.querySelectorAll<HTMLButtonElement>('[data-out-del]').forEach((btn) => {
          btn.addEventListener('click', () => {
            item.outputs.splice(Number(btn.dataset.outDel), 1);
            renderDeliverables();
          });
        });
      }

      function populatePortfolioForm() {
        renderPortfolioList();
        const item = state.portfolios.items?.[state.selectedPortoIdx];
        if (!item) return;
        const lang = state.editLang;

        document.getElementById('porto-editor-heading')!.textContent = `Edit: ${item.title}`;
        (document.getElementById('porto-title') as HTMLInputElement).value = item.title || '';
        (document.getElementById('porto-year') as HTMLInputElement).value = item.year || '2026';
        (document.getElementById('porto-filter-class') as HTMLSelectElement).value = item.filterClass || 'content-media';
        (document.getElementById('porto-tags') as HTMLInputElement).value = (item.tags || []).join(', ');
        (document.getElementById('porto-image-src') as HTMLInputElement).value = item.imageSrc || '';
        (document.getElementById('porto-thumb-preview') as HTMLImageElement).src = item.imageSrc || '/images/portfolio/fame.jpg';
        (document.getElementById('porto-featured-home') as HTMLInputElement).checked = Boolean(item.featuredOnHome);

        const scVal = typeof item.scopes === 'object' ? item.scopes[lang] : item.scopes;
        const descVal = typeof item.description === 'object' ? item.description[lang] : item.description;
        (document.getElementById('porto-scopes') as HTMLInputElement).value = scVal || '';
        (document.getElementById('porto-desc') as HTMLTextAreaElement).value = descVal || '';

        renderDeliverables();
      }

      function readPortfolioForm() {
        const item = state.portfolios.items?.[state.selectedPortoIdx];
        if (!item) return;
        const lang = state.editLang;

        item.title = (document.getElementById('porto-title') as HTMLInputElement).value.trim();
        item.year = (document.getElementById('porto-year') as HTMLInputElement).value.trim();
        const fc = (document.getElementById('porto-filter-class') as HTMLSelectElement).value;
        item.filterClass = fc;
        const catMap: Record<string, string> = {
          'content-media': 'Content & Media Management',
          'brand-digital': 'Brand & Digital Foundation',
          'visual-doc': 'Visual Production & Documentation',
        };
        item.category = catMap[fc] || 'Content & Media Management';
        item.tags = (document.getElementById('porto-tags') as HTMLInputElement).value
          .split(',')
          .map((t) => t.trim())
          .filter(Boolean);
        item.imageSrc = (document.getElementById('porto-image-src') as HTMLInputElement).value.trim();
        item.featuredOnHome = (document.getElementById('porto-featured-home') as HTMLInputElement).checked;

        if (typeof item.scopes !== 'object' || !item.scopes) {
          item.scopes = { id: String(item.scopes || ''), en: String(item.scopes || '') };
        }
        if (typeof item.description !== 'object' || !item.description) {
          item.description = { id: String(item.description || ''), en: String(item.description || '') };
        }
        item.scopes[lang] = (document.getElementById('porto-scopes') as HTMLInputElement).value.trim();
        item.description[lang] = (document.getElementById('porto-desc') as HTMLTextAreaElement).value.trim();
      }

      document.getElementById('porto-image-src')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value.trim();
        (document.getElementById('porto-thumb-preview') as HTMLImageElement).src = val || '/images/portfolio/fame.jpg';
      });

      document.getElementById('porto-thumb-upload')?.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        const url = await handleFileUpload(file, 'portfolio');
        (document.getElementById('porto-image-src') as HTMLInputElement).value = url;
        (document.getElementById('porto-thumb-preview') as HTMLImageElement).src = url;
        readPortfolioForm();
        renderPortfolioList();
      });

      document.getElementById('btn-add-portfolio')?.addEventListener('click', () => {
        readPortfolioForm();
        state.portfolios.items.unshift({
          id: `project-${Date.now()}`,
          title: 'Klien Baru',
          category: 'Content & Media Management',
          filterClass: 'content-media',
          year: String(new Date().getFullYear()),
          tags: ['Social Media Management'],
          imageSrc: '/images/portfolio/fame.jpg',
          featuredOnHome: false,
          scopes: { id: 'Social Media Management', en: 'Social Media Management' },
          description: { id: 'Deskripsi proyek...', en: 'Project description...' },
          outputs: [],
        });
        state.selectedPortoIdx = 0;
        populatePortfolioForm();
        showToast('Proyek baru ditambahkan!');
      });

      document.getElementById('btn-delete-portfolio')?.addEventListener('click', () => {
        if (!confirm('Hapus proyek portofolio ini?')) return;
        state.portfolios.items.splice(state.selectedPortoIdx, 1);
        state.selectedPortoIdx = 0;
        populatePortfolioForm();
        showToast('Proyek dihapus.');
      });

      document.getElementById('btn-add-deliverable')?.addEventListener('click', () => {
        const item = state.portfolios.items?.[state.selectedPortoIdx];
        if (!item) return;
        if (!item.outputs) item.outputs = [];
        item.outputs.push({ type: 'image', label: 'Deliverable Baru', url: '/images/portfolio/fame.jpg' });
        renderDeliverables();
      });

