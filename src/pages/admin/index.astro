      function populateContactForm() {
        const lang = state.editLang;
        const c = state.settings.contact || {};
        (document.getElementById('contact-tag') as HTMLInputElement).value = c.tag?.[lang] || 'Get in Touch';
        (document.getElementById('contact-title') as HTMLInputElement).value = c.title?.[lang] || '';
        (document.getElementById('contact-subtitle') as HTMLTextAreaElement).value = c.subtitle?.[lang] || '';
        (document.getElementById('contact-budgets') as HTMLTextAreaElement).value = (c.budgetRanges?.[lang] || []).join('\n');

        (document.getElementById('contact-email') as HTMLInputElement).value = c.email || '';
        (document.getElementById('contact-location') as HTMLInputElement).value = c.location?.[lang] || '';
        (document.getElementById('contact-ig-handle') as HTMLInputElement).value = c.instagramHandle || '';
        (document.getElementById('contact-ig-url') as HTMLInputElement).value = c.instagramUrl || '';

        (document.getElementById('thanks-title-input') as HTMLInputElement).value = c.thanks?.[lang]?.title || '';
        (document.getElementById('thanks-cta-input') as HTMLInputElement).value = c.thanks?.[lang]?.cta || '';
        (document.getElementById('thanks-sub-input') as HTMLTextAreaElement).value = c.thanks?.[lang]?.subtitle || '';
      }

      function readContactForm() {
        const lang = state.editLang;
        if (!state.settings.contact) state.settings.contact = {};
        const c = state.settings.contact;
        if (!c.tag) c.tag = {};
        if (!c.title) c.title = {};
        if (!c.subtitle) c.subtitle = {};
        if (!c.budgetRanges) c.budgetRanges = {};
        if (!c.location) c.location = {};
        if (!c.thanks) c.thanks = { id: {}, en: {} };

        c.tag[lang] = (document.getElementById('contact-tag') as HTMLInputElement).value.trim();
        c.title[lang] = (document.getElementById('contact-title') as HTMLInputElement).value.trim();
        c.subtitle[lang] = (document.getElementById('contact-subtitle') as HTMLTextAreaElement).value.trim();
        c.budgetRanges[lang] = (document.getElementById('contact-budgets') as HTMLTextAreaElement).value
          .split('\n')
          .map((s) => s.trim())
          .filter(Boolean);

        c.email = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
        c.location[lang] = (document.getElementById('contact-location') as HTMLInputElement).value.trim();
        c.instagramHandle = (document.getElementById('contact-ig-handle') as HTMLInputElement).value.trim();
        c.instagramUrl = (document.getElementById('contact-ig-url') as HTMLInputElement).value.trim();

        if (!c.thanks[lang]) c.thanks[lang] = {};
        c.thanks[lang].title = (document.getElementById('thanks-title-input') as HTMLInputElement).value.trim();
        c.thanks[lang].cta = (document.getElementById('thanks-cta-input') as HTMLInputElement).value.trim();
        c.thanks[lang].subtitle = (document.getElementById('thanks-sub-input') as HTMLTextAreaElement).value.trim();
      }

      // =========================================================
      // PANEL 4: BLOG SUPABASE CMS LOGIC
      // =========================================================
      function slugify(text: string): string {
        return text
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '');
      }

