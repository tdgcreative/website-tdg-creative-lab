  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

ALTER TABLE public.blog_articles ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.site_settings ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "Public access blog_articles" ON public.blog_articles;
CREATE POLICY "Public access blog_articles" ON public.blog_articles FOR ALL USING (true) WITH CHECK (true);

DROP POLICY IF EXISTS "Public access site_settings" ON public.site_settings;
