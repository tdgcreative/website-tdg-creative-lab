      const ADMIN_VALID_USER = 'Admin TDG';
      const ADMIN_VALID_PASS = 'AAdmin.tdg123!';
      const AUTH_STORAGE_KEY = 'tdg_admin_auth_v2';
      const STATE_STORAGE_KEY = 'tdg_cms_state_v1';

      const rawInitial = document.getElementById('initial-cms-data')?.textContent || '{}';
      const parsedInitial = JSON.parse(rawInitial);

      const state = {
        activePanel: 'home' as 'home' | 'portfolios' | 'contact' | 'blog' | 'whatsapp' | 'tracking' | 'supabase',
        editLang: 'id' as 'id' | 'en',
