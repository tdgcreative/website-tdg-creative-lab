      // Toast helper
      let toastTimer: any = null;
      function showToast(msg: string) {
        const toast = document.getElementById('admin-toast');
        const msgEl = document.getElementById('admin-toast-msg');
        if (!toast || !msgEl) return;
        msgEl.textContent = msg;
        toast.classList.remove('translate-y-24', 'opacity-0');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.add('translate-y-24', 'opacity-0');
        }, 3500);
      }

      // Upload helper (tries Supabase Storage -> Local Dev API -> Base64 DataURL)
      async function handleFileUpload(file: File, folder = 'portfolio'): Promise<string> {
        showToast('Mengunggah gambar...');
        // 1. Try local Vite dev API first so local files are updated in dev
        try {
          const dataUrl = await new Promise<string>((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result));
            reader.onerror = reject;
            reader.readAsDataURL(file);
          });

          const localRes = await fetch('/api/admin/upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: file.name, folder, dataUrl }),
          });
          if (localRes.ok) {
            const json = await localRes.json();
            if (json.ok && json.url) {
              // Also upload to Supabase Storage in background
              uploadMediaToSupabase(file, folder).catch(() => {});
              showToast('Gambar berhasil diunggah!');
              return json.url;
            }
          }
        } catch {}

        // 2. Try Supabase Storage
        const supaUp = await uploadMediaToSupabase(file, folder);
        if (supaUp.ok && supaUp.url) {
          showToast('Gambar berhasil diunggah ke Supabase Storage!');
          return supaUp.url;
        }

        // 3. Fallback to Data URL
        return await new Promise<string>((resolve) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result));
          reader.readAsDataURL(file);
        });
      }

      // =========================================================
      // AUTHENTICATION
      // =========================================================
      function checkAuth() {
        const isLogged = sessionStorage.getItem(AUTH_STORAGE_KEY) === 'true' || localStorage.getItem(AUTH_STORAGE_KEY) === 'true';
        const gate = document.getElementById('admin-login-gate');
        const app = document.getElementById('admin-app');
        if (isLogged) {
          gate?.classList.add('hidden');
          app?.classList.remove('hidden');
          initWorkspace();
        } else {
          gate?.classList.remove('hidden');
          app?.classList.add('hidden');
        }
      }

      document.getElementById('toggle-pass-btn')?.addEventListener('click', () => {
        const passInput = document.getElementById('admin-pass-input') as HTMLInputElement;
        const btn = document.getElementById('toggle-pass-btn')!;
        if (passInput.type === 'password') {
          passInput.type = 'text';
          btn.textContent = 'Sembunyikan';
        } else {
          passInput.type = 'password';
          btn.textContent = 'Lihat';
        }
      });

      document.getElementById('login-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const userVal = (document.getElementById('admin-user-input') as HTMLInputElement).value.trim();
        const passVal = (document.getElementById('admin-pass-input') as HTMLInputElement).value;
        const errEl = document.getElementById('login-error')!;

        if (userVal.toLowerCase() === ADMIN_VALID_USER.toLowerCase() && passVal === ADMIN_VALID_PASS) {
          errEl.classList.add('hidden');
          sessionStorage.setItem(AUTH_STORAGE_KEY, 'true');
          localStorage.setItem(AUTH_STORAGE_KEY, 'true');
          checkAuth();
        } else {
          errEl.classList.remove('hidden');
        }
      });

      document.getElementById('btn-logout')?.addEventListener('click', () => {
        sessionStorage.removeItem(AUTH_STORAGE_KEY);
        localStorage.removeItem(AUTH_STORAGE_KEY);
        checkAuth();
      });

