---
import '../../styles/global.css';
import { loadHomeData, loadPortfoliosData, loadBlogData, loadSettingsData } from '../../utils/data-loader';
import { DEFAULT_SUPABASE_URL, DEFAULT_SUPABASE_ANON_KEY, fetchSupabaseBlogArticles } from '../../utils/supabase';

const initialHome = loadHomeData();
const initialPortfolios = loadPortfoliosData();
const localBlog = loadBlogData();
const supaArticles = await fetchSupabaseBlogArticles();
const initialBlog = (supaArticles && supaArticles.length > 0)
  ? { seo: localBlog.seo, articles: supaArticles }
  : localBlog;
const initialSettings = loadSettingsData();

const initialPayload = JSON.stringify({
  home: initialHome,
  portfolios: initialPortfolios,
  blog: initialBlog,
  settings: initialSettings,
  supabase: {
    url: import.meta.env.PUBLIC_SUPABASE_URL || DEFAULT_SUPABASE_URL,
    key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || DEFAULT_SUPABASE_ANON_KEY,
  }
});
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel — The Digital Grounds</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/TDG LOGO TRANSPARENT.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      .admin-sans,
      .admin-sans * {
        font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        letter-spacing: -0.01em;
      }
    </style>
  </head>
  <body class="admin-sans min-h-screen bg-[#F6F6F4] text-[#141414] font-sans antialiased selection:bg-brand-orange selection:text-white">
    
    <!-- ========================================================= -->
    <!-- 1. MINIMALIST LOGIN GATE                                  -->
    <!-- ========================================================= -->
    <div id="admin-login-gate" class="fixed inset-0 z-50 bg-[#F6F6F4] flex items-center justify-center p-4">
      <div class="w-full max-w-md bg-white border border-black/10 rounded-3xl p-8 sm:p-10 shadow-xl">
        <div class="flex flex-col items-center text-center mb-8">
          <span class="text-[11px] font-semibold uppercase tracking-widest text-brand-orange bg-brand-orange/10 px-3 py-1 rounded-full mb-3">
            Admin Dashboard
          </span>
          <h1 class="text-2xl font-bold tracking-tight text-[#141414]">Masuk ke CMS Website</h1>
          <p class="text-xs text-black/55 mt-1.5 leading-relaxed">
            Kelola konten tiap halaman, nomor WhatsApp, Meta Pixel & GTM, serta Blog berbasis Supabase.
          </p>
        </div>

        <form id="login-form" class="space-y-4">
          <div>
            <label for="admin-user-input" class="block text-xs font-semibold text-black/70 mb-1.5">
              Username
            </label>
            <input
              id="admin-user-input"
              type="text"
              required
              autocomplete="username"
              placeholder="Masukkan username admin..."
              class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl px-4 py-3 text-sm text-[#141414] outline-none transition-all"
            />
          </div>

          <div>
            <label for="admin-pass-input" class="block text-xs font-semibold text-black/70 mb-1.5">
              Password
            </label>
            <div class="relative">
              <input
                id="admin-pass-input"
                type="password"
                required
                autocomplete="current-password"
                placeholder="Masukkan password..."
                class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl pl-4 pr-12 py-3 text-sm text-[#141414] outline-none transition-all"
              />
              <button
                type="button"
                id="toggle-pass-btn"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-black/45 hover:text-black cursor-pointer px-1.5 py-1"
              >
                Lihat
              </button>
            </div>
          </div>

          <div id="login-error" class="hidden rounded-xl bg-red-50 border border-red-200 px-4 py-2.5 text-xs font-semibold text-red-600">
            Username atau password tidak sesuai. Silakan periksa kembali.
          </div>

          <button
            type="submit"
            class="w-full bg-[#141414] hover:bg-brand-orange text-white font-semibold text-xs uppercase tracking-wider py-3.5 rounded-xl transition-colors shadow-sm cursor-pointer mt-2"
          >
            Masuk ke Dashboard
          </button>
        </form>
      </div>
    </div>

    <!-- ========================================================= -->
    <!-- 2. MAIN ADMIN WORKSPACE (SIDEBAR + CONTENT)               -->
    <!-- ========================================================= -->
    <div id="admin-app" class="hidden min-h-screen flex flex-col lg:flex-row">
      
      <!-- Mobile Header Bar -->
      <header class="lg:hidden sticky top-0 z-30 bg-white border-b border-black/10 px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="mobile-sidebar-toggle"
            class="px-3 py-1.5 rounded-xl border border-black/10 text-xs font-semibold text-black hover:bg-black/5 cursor-pointer"
            aria-label="Toggle Menu"
          >
            Menu
          </button>
          <span class="font-bold text-sm tracking-tight">TDG Admin</span>
        </div>
        <a href="/" target="_blank" class="text-xs font-semibold text-brand-orange hover:underline">Lihat Web</a>
      </header>

      <!-- Sidebar Backdrop (Mobile) -->
      <div id="sidebar-backdrop" class="fixed inset-0 z-30 bg-black/40 hidden lg:hidden"></div>

      <!-- LEFT SIDEBAR NAVIGATION -->
      <aside
        id="admin-sidebar"
        class="fixed lg:sticky top-0 left-0 z-40 h-screen w-72 bg-white border-r border-black/10 flex flex-col justify-between shrink-0 transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out"
      >
        <div class="p-6 overflow-y-auto flex-1">
          <!-- Brand Header -->
          <div class="flex items-center justify-between pb-6 mb-6 border-b border-black/10">
            <a href="/admin" class="block">
              <span class="block text-base font-bold tracking-tight text-[#141414] leading-none">TDG Creative Lab</span>
              <span class="text-xs font-medium text-black/45 mt-1 block">Website CMS</span>
            </a>
          </div>

          <!-- Group 1: Edit Tiap Halaman -->
          <div class="mb-6">
            <span class="px-3 text-[10px] font-semibold uppercase tracking-widest text-black/40 block mb-2">
              Konten & Gambar Halaman
            </span>
            <nav class="space-y-1">
              <button
                type="button"
                data-nav="home"
                class="sidebar-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-[#141414] text-white"
              >
                <span>Halaman Beranda</span>
              </button>

              <button
                type="button"
                data-nav="portfolios"
                class="sidebar-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer text-black/70 hover:bg-black/5 hover:text-black"
              >
                <span>Halaman Portofolio</span>
                <span id="nav-porto-count" class="text-[10px] px-2 py-0.5 rounded-full bg-black/10 font-semibold">0</span>
              </button>

              <button
                type="button"
                data-nav="contact"
                class="sidebar-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer text-black/70 hover:bg-black/5 hover:text-black"
              >
                <span>Halaman Kontak</span>
              </button>
            </nav>
          </div>

          <!-- Group 2: Blog Supabase -->
          <div class="mb-6">
            <span class="px-3 text-[10px] font-semibold uppercase tracking-widest text-black/40 block mb-2">
              Publikasi Artikel
            </span>
            <nav class="space-y-1">
              <button
                type="button"
                data-nav="blog"
                class="sidebar-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer text-black/70 hover:bg-black/5 hover:text-black"
              >
                <span>Artikel Blog (Supabase)</span>
                <span id="nav-blog-count" class="text-[10px] px-2 py-0.5 rounded-full bg-brand-orange/15 text-brand-orange font-semibold">0</span>
              </button>
            </nav>
          </div>

          <!-- Group 3: Pengaturan Global & Integrasi -->
          <div>
            <span class="px-3 text-[10px] font-semibold uppercase tracking-widest text-black/40 block mb-2">
              Pengaturan Global & Pixel
            </span>
            <nav class="space-y-1">
              <button
                type="button"
                data-nav="whatsapp"
                class="sidebar-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer text-black/70 hover:bg-black/5 hover:text-black"
              >
                <span>Nomor WhatsApp Global</span>
              </button>

              <button
                type="button"
                data-nav="tracking"
                class="sidebar-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer text-black/70 hover:bg-black/5 hover:text-black"
              >
                <span>Meta Pixel & GTM</span>
              </button>

              <button
                type="button"
                data-nav="supabase"
                class="sidebar-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all cursor-pointer text-black/70 hover:bg-black/5 hover:text-black"
              >
                <span>Database Supabase</span>
              </button>
            </nav>
          </div>
        </div>

        <!-- Sidebar Footer: User Info & Actions -->
        <div class="p-4 border-t border-black/10 bg-[#FAFAFA] space-y-2.5">
          <div class="flex items-center justify-between px-2">
            <div>
              <span class="block text-xs font-semibold text-[#141414] leading-none">Admin TDG</span>
              <span id="storage-mode-text" class="text-[10px] text-emerald-600 font-medium mt-0.5 block">Supabase Terhubung</span>
            </div>
            <button
              type="button"
              id="btn-logout"
              class="text-xs font-semibold text-red-600 hover:underline cursor-pointer"
            >
              Keluar
            </button>
          </div>

          <div class="grid grid-cols-2 gap-2 pt-1">
            <a
              href="/"
              target="_blank"
              class="flex items-center justify-center py-2 px-3 rounded-xl border border-black/10 bg-white hover:bg-black/5 text-xs font-semibold text-black/80 transition-colors"
            >
              <span>Lihat Web</span>
            </a>
            <button
              type="button"
              id="btn-save-all-top"
              class="flex items-center justify-center py-2 px-3 rounded-xl bg-brand-orange hover:bg-brand-orange-light text-xs font-semibold text-white transition-colors cursor-pointer"
            >
              <span>Simpan</span>
            </button>
          </div>
        </div>
      </aside>

      <!-- RIGHT MAIN WORKSPACE -->
      <div class="flex-1 flex flex-col min-w-0">
        <!-- Top Sticky Toolbar -->
        <div class="sticky top-0 z-20 bg-[#F6F6F4]/90 backdrop-blur-md border-b border-black/10 px-6 py-4 flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 id="workspace-title" class="text-lg sm:text-xl font-bold tracking-tight text-[#141414]">
              Edit Halaman Beranda (Home)
            </h2>
            <p id="workspace-subtitle" class="text-xs text-black/55 mt-0.5">
              Ubah teks dan gambar yang tampil di halaman utama website.
            </p>
          </div>

          <div class="flex items-center gap-3">
            <!-- Global Language Switcher for Page Editors -->
            <div id="global-lang-switcher" class="flex items-center bg-white p-1 rounded-xl border border-black/10">
              <button
                type="button"
                data-edit-lang="id"
                class="edit-lang-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#141414] text-white cursor-pointer transition-all"
              >
                Bahasa ID
              </button>
              <button
                type="button"
                data-edit-lang="en"
                class="edit-lang-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-black/60 hover:text-black cursor-pointer transition-all"
              >
                English
              </button>
            </div>

            <button
              type="button"
              id="btn-primary-save"
              class="bg-[#141414] hover:bg-brand-orange text-white font-semibold text-xs px-5 py-2.5 rounded-xl transition-colors shadow-sm cursor-pointer"
            >
              Simpan Perubahan
            </button>
          </div>
        </div>

        <!-- Toast Notification -->
        <div
          id="admin-toast"
          class="fixed bottom-5 right-5 z-50 max-w-md bg-[#141414] text-white px-5 py-3.5 rounded-2xl shadow-xl flex items-center gap-3 transform translate-y-24 opacity-0 pointer-events-none transition-all duration-300"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-brand-orange shrink-0"></span>
          <span id="admin-toast-msg" class="text-xs font-bold leading-snug">Perubahan berhasil disimpan!</span>
        </div>

        <!-- Main Content Area -->
        <main class="flex-1 p-6 max-w-5xl w-full mx-auto space-y-6">

          <!-- ===================================================== -->
          <!-- PANEL 1: HALAMAN BERANDA (HOME)                       -->
          <!-- ===================================================== -->
          <section id="panel-home" class="admin-panel space-y-6">
            <!-- 1. Hero Section -->
            <div class="bg-white p-6 rounded-2xl border border-black/10 space-y-4 shadow-2xs">
              <div class="flex items-center justify-between border-b border-black/5 pb-3">
                <div>
                  <h3 class="text-sm font-semibold text-[#141414]">1. Hero Banner Utama</h3>
                  <p class="text-xs text-black/50">Teks pembuka paling atas di halaman beranda.</p>
                </div>
                <span class="active-lang-badge text-[11px] font-semibold px-2.5 py-1 rounded-full bg-brand-orange/10 text-brand-orange">Bahasa ID</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium text-black/70 mb-1">Headline Baris 1 (Besar)</label>
                  <input id="home-hero-main" type="text" class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-black/70 mb-1">Headline Baris 2</label>
                  <input id="home-hero-sub" type="text" class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-medium text-black/70 mb-1">Sub-headline / Tagline</label>
                <input id="home-hero-desc" type="text" class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl px-3.5 py-2.5 text-sm outline-none" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium text-black/70 mb-1">Teks Tombol Utama (Kiri)</label>
                  <input id="home-hero-cta1" type="text" class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-black/70 mb-1">Teks Tombol Kedua (Kanan)</label>
                  <input id="home-hero-cta2" type="text" class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
              </div>
            </div>

            <!-- 2. Logo Klien (Marquee Gambar) -->
            <div class="bg-white p-6 rounded-2xl border border-black/10 space-y-4 shadow-2xs">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-black/5 pb-3">
                <div>
                  <h3 class="text-sm font-semibold text-[#141414]">2. Gambar Logo Klien (Marquee)</h3>
                  <p class="text-xs text-black/50">Kelola gambar logo brand klien yang berjalan di halaman utama.</p>
                </div>
                <button
                  type="button"
                  id="btn-add-logo"
                  class="px-3.5 py-2 rounded-xl bg-[#141414] hover:bg-brand-orange text-white text-xs font-semibold transition-colors cursor-pointer"
                >
                  Tambah Logo
                </button>
              </div>

              <div>
                <label class="block text-xs font-medium text-black/70 mb-1">Judul Baris Logo</label>
                <input id="home-marquee-badge" type="text" class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl px-3.5 py-2.5 text-sm outline-none" />
              </div>

              <div id="home-logos-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-[380px] overflow-y-auto pr-1"></div>
            </div>

            <!-- 3. Core Pitch & Statistik -->
            <div class="bg-white p-6 rounded-2xl border border-black/10 space-y-4 shadow-2xs">
              <div class="flex items-center justify-between border-b border-black/5 pb-3">
                <div>
                  <h3 class="text-sm font-semibold text-[#141414]">3. Core Pitch & Angka Statistik</h3>
                  <p class="text-xs text-black/50">Penjelasan nilai utama agensi dan klaim statistik.</p>
                </div>
                <span class="active-lang-badge text-[11px] font-semibold px-2.5 py-1 rounded-full bg-brand-orange/10 text-brand-orange">Bahasa ID</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                  <label class="block text-xs font-medium text-black/70 mb-1">Label Kecil</label>
                  <input id="home-pitch-tag" type="text" class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-xs font-medium text-black/70 mb-1">Judul Pitch</label>
                  <input id="home-pitch-title" type="text" class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-medium text-black/70 mb-1">Paragraf Penjelasan</label>
                <textarea id="home-pitch-desc" rows="3" class="w-full bg-[#F9F9F8] border border-black/15 focus:border-brand-orange focus:bg-white rounded-xl px-3.5 py-2.5 text-sm outline-none"></textarea>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
                <div>
                  <label class="block text-[11px] font-medium text-black/60 mb-1">Angka Stat 1</label>
                  <input id="home-stat1-val" type="text" class="w-full bg-[#F9F9F8] border border-black/15 rounded-xl px-3 py-2 text-sm font-semibold outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] font-medium text-black/60 mb-1">Label Stat 1</label>
                  <input id="home-stat1-lbl" type="text" class="w-full bg-[#F9F9F8] border border-black/15 rounded-xl px-3 py-2 text-sm outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] font-medium text-black/60 mb-1">Angka Stat 2</label>
                  <input id="home-stat2-val" type="text" class="w-full bg-[#F9F9F8] border border-black/15 rounded-xl px-3 py-2 text-sm font-semibold outline-none" />
                </div>
                <div>
                  <label class="block text-[11px] font-medium text-black/60 mb-1">Label Stat 2</label>
                  <input id="home-stat2-lbl" type="text" class="w-full bg-[#F9F9F8] border border-black/15 rounded-xl px-3 py-2 text-sm outline-none" />
                </div>
              </div>
            </div>

            <!-- 4. Ruang Lingkup Layanan & Industri -->
            <div class="bg-white p-6 rounded-2xl border border-black/10 space-y-4 shadow-2xs">
              <div class="border-b border-black/5 pb-3">
                <h3 class="text-sm font-semibold text-[#141414]">4. Seksi Portofolio, Layanan & Industri</h3>
                <p class="text-xs text-black/50">Judul seksi karya, ruang lingkup layanan (Scopes), dan daftar industri.</p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium text-black/70 mb-1">Judul Seksi Portofolio</label>
                  <input id="home-porto-title" type="text" class="w-full bg-[#F9F9F8] border border-black/15 rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-black/70 mb-1">Teks Tombol Lihat Semua Karya</label>
                  <input id="home-porto-cta" type="text" class="w-full bg-[#F9F9F8] border border-black/15 rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium text-black/70 mb-1">Judul Ruang Lingkup Layanan</label>
                  <input id="home-scopes-title" type="text" class="w-full bg-[#F9F9F8] border border-black/15 rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-black/70 mb-1">Daftar Industri (Pisahkan dengan koma)</label>
                  <input id="home-ind-list" type="text" class="w-full bg-[#F9F9F8] border border-black/15 rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-medium text-black/70 mb-2">Item Ruang Lingkup Layanan (01 - 04)</label>
                <div id="home-scopes-list" class="space-y-3"></div>
              </div>
            </div>

            <!-- 5. Banner CTA Bawah & SEO Beranda -->
            <div class="bg-white p-6 rounded-2xl border border-black/10 space-y-4 shadow-2xs">
              <div class="border-b border-black/5 pb-3">
                <h3 class="text-sm font-semibold text-[#141414]">5. Banner CTA Konsultasi & SEO Beranda</h3>
                <p class="text-xs text-black/50">Teks ajakan konsultasi WhatsApp di bagian bawah halaman dan Meta SEO.</p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-medium text-black/70 mb-1">Judul Banner CTA</label>
                  <input id="cta-banner-title" type="text" class="w-full bg-[#F9F9F8] border border-black/15 rounded-xl px-3.5 py-2.5 text-sm outline-none" />
                </div>
                <div>
