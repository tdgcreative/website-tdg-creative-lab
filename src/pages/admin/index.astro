          }
        });

        const meta = panelMeta[panel];
        if (meta) {
          document.getElementById('workspace-title')!.textContent = meta.title;
          document.getElementById('workspace-subtitle')!.textContent = meta.subtitle;
          const langSw = document.getElementById('global-lang-switcher')!;
          if (meta.showLang) langSw.classList.remove('hidden');
          else langSw.classList.add('hidden');
        }

        // Close mobile sidebar
        document.getElementById('admin-sidebar')?.classList.add('-translate-x-full');
        document.getElementById('sidebar-backdrop')?.classList.add('hidden');

        populateCurrentPanel();
      }

      document.querySelectorAll('.sidebar-nav-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-nav') as typeof state.activePanel;
          if (target) switchPanel(target);
