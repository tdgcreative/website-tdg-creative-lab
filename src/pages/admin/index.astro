      function readHomeForm() {
        const lang = state.editLang;
        const h = state.home;
        if (!h.hero) h.hero = { subheadline: {}, primaryCta: {}, secondaryCta: {} };
        h.hero.headlineMain = (document.getElementById('home-hero-main') as HTMLInputElement).value.trim();
        h.hero.headlineSub = (document.getElementById('home-hero-sub') as HTMLInputElement).value.trim();
        h.hero.subheadline[lang] = (document.getElementById('home-hero-desc') as HTMLInputElement).value.trim();
        h.hero.primaryCta[lang] = (document.getElementById('home-hero-cta1') as HTMLInputElement).value.trim();
        h.hero.secondaryCta[lang] = (document.getElementById('home-hero-cta2') as HTMLInputElement).value.trim();

        if (h.marquee?.badgeText) {
          h.marquee.badgeText[lang] = (document.getElementById('home-marquee-badge') as HTMLInputElement).value.trim();
        }
        if (h.pitch) {
          h.pitch.tag[lang] = (document.getElementById('home-pitch-tag') as HTMLInputElement).value.trim();
          h.pitch.title[lang] = (document.getElementById('home-pitch-title') as HTMLInputElement).value.trim();
          h.pitch.description[lang] = (document.getElementById('home-pitch-desc') as HTMLTextAreaElement).value.trim();
          if (h.pitch.stats?.[0]) {
            h.pitch.stats[0].value = (document.getElementById('home-stat1-val') as HTMLInputElement).value.trim();
            h.pitch.stats[0].label[lang] = (document.getElementById('home-stat1-lbl') as HTMLInputElement).value.trim();
          }
          if (h.pitch.stats?.[1]) {
            h.pitch.stats[1].value = (document.getElementById('home-stat2-val') as HTMLInputElement).value.trim();
            h.pitch.stats[1].label[lang] = (document.getElementById('home-stat2-lbl') as HTMLInputElement).value.trim();
          }
        }
        if (h.portfolioSection) {
          h.portfolioSection.title[lang] = (document.getElementById('home-porto-title') as HTMLInputElement).value.trim();
          h.portfolioSection.ctaText[lang] = (document.getElementById('home-porto-cta') as HTMLInputElement).value.trim();
        }
        if (h.serviceScopesSection) {
          h.serviceScopesSection.title[lang] = (document.getElementById('home-scopes-title') as HTMLInputElement).value.trim();
        }
        if (h.industriesSection) {
          h.industriesSection.industries = (document.getElementById('home-ind-list') as HTMLInputElement).value
            .split(',')
            .map((s) => s.trim())
            .filter(Boolean);
        }
        if (h.seo?.[lang]) {
          h.seo[lang].title = (document.getElementById('home-seo-title') as HTMLInputElement).value.trim();
          h.seo[lang].description = (document.getElementById('home-seo-desc') as HTMLInputElement).value.trim();
        }

        if (!state.settings.ctaBanner) {
          state.settings.ctaBanner = { title: {}, description: {}, buttonText: {} };
        }
        state.settings.ctaBanner.title[lang] = (document.getElementById('cta-banner-title') as HTMLInputElement).value.trim();
        state.settings.ctaBanner.buttonText[lang] = (document.getElementById('cta-banner-btn') as HTMLInputElement).value.trim();
        state.settings.ctaBanner.description[lang] = (document.getElementById('cta-banner-desc') as HTMLTextAreaElement).value.trim();
