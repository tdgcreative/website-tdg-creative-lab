        tracking: {
          title: 'Meta Ads Pixel & Google Tag Manager',
          subtitle: 'Tempelkan ID Meta Pixel dan GTM agar otomatis terpasang di seluruh halaman website.',
          showLang: false,
        },
        supabase: {
