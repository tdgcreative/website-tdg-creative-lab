---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  category: string;
  tags: string[];
  imageSrc: ImageMetadata | string;
  svgIcon?: string;
  loading?: "lazy" | "eager";
  imagePosition?: string;
  imageFit?: "cover" | "contain";
}

const { 
  title, 
  category, 
  tags, 
  imageSrc, 
  svgIcon, 
  loading = "lazy",
  imagePosition = "object-center",
  imageFit = "cover"
} = Astro.props;

const isStringImage = typeof imageSrc === 'string';
const assetImages = import.meta.glob<{ default: ImageMetadata }>('../assets/portfolio/*.{jpg,jpeg,png,webp}', { eager: true });

let resolvedAssetImage: ImageMetadata | null = null;
if (!isStringImage) {
  resolvedAssetImage = imageSrc as ImageMetadata;
} else {
  const filename = (imageSrc as string).split('/').pop();
  if (filename && (imageSrc as string).startsWith('/images/portfolio/') && (imageSrc as string).split('/').length === 4) {
    const matchKey = `../assets/portfolio/${filename}`;
    if (assetImages[matchKey]?.default) {
      resolvedAssetImage = assetImages[matchKey].default;
    }
  }
}

const objectPositionStyle = imagePosition.includes('top') ? 'top center' : 'center center';
---

<div class="relative group overflow-hidden rounded-2xl sm:rounded-3xl p-5 sm:p-6 md:p-8 aspect-square md:aspect-[4/3] flex flex-col justify-end text-white border border-brand-dark/10 shadow-sm transition-all duration-500 hover:shadow-2xl hover:-translate-y-1.5 bg-brand-dark">
  <!-- Background Client Image -->
  {resolvedAssetImage ? (
    <Image 
      src={resolvedAssetImage} 
      alt={`Project showcase for ${title}`}
      width={900}
      loading={loading}
      style={{ objectPosition: objectPositionStyle }}
      class={`absolute inset-0 w-full h-full ${imageFit === 'contain' ? 'object-contain' : 'object-cover'} transition-transform duration-700 scale-100 group-hover:scale-105`}
    />
  ) : (
    <img 
      src={imageSrc as string} 
      alt={`Project showcase for ${title}`}
      width="900"
      height="675"
      loading={loading}
      style={{ objectPosition: objectPositionStyle }}
      class={`absolute inset-0 w-full h-full ${imageFit === 'contain' ? 'object-contain' : 'object-cover'} transition-transform duration-700 scale-100 group-hover:scale-105`}
    />
  )}
  
  <!-- Linear Bottom shadow gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-transparent transition-all duration-300 group-hover:from-black" />

  <!-- Radial Gradient Overlay on Hover -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,80,0,0.15),transparent_60%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
  
  <!-- Abstract Decorative SVG Pattern Behind -->
  <div class="absolute top-4 right-4 sm:top-6 sm:right-6 w-16 h-16 sm:w-24 sm:h-24 opacity-20 transition-all duration-500 group-hover:scale-110 group-hover:rotate-12 group-hover:opacity-30 text-white/40 z-10">
    {svgIcon === 'fashion' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
      </svg>
    )}
    {svgIcon === 'healthcare' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
      </svg>
    )}
    {(svgIcon === 'fnb' || svgIcon === 'food') && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697-.056-4.024-.166C6.845 7.91 6 6.94 6 5.824V3.75h12v2.074c0 1.117-.846 2.087-1.976 2.16-1.327.11-2.669.166-4.024.166zm-7.5 12h15m-15 0a.75.75 0 01-.75-.75 2.25 2.25 0 012.25-2.25h12a2.25 2.25 0 012.25 2.25.75 0 01-.75.75m-15 0v-1.5m15 0v1.5M9 9.75v1.5a3 3 0 006 0v-1.5" />
      </svg>
    )}
    {svgIcon === 'dental' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499c.174-.174.453-.174.627 0l8.25 8.25a.44.44 0 01-.313.75h-2.148v6.75a1.5 1.5 0 01-1.5 1.5h-10.5a1.5 1.5 0 01-1.5-1.5v-6.75H2.576a.44.44 0 01-.313-.75l8.25-8.25z" />
      </svg>
    )}
    {svgIcon === 'sport' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0" />
      </svg>
    )}
    {svgIcon === 'architecture' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
      </svg>
    )}
    {svgIcon === 'corporate' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
      </svg>
    )}
  </div>

  <!-- Card Content -->
  <div class="relative z-10 flex flex-col gap-3 sm:gap-4 transform transition-all duration-500 group-hover:translate-y-0 translate-y-1 sm:translate-y-2">
    <div>
      <span class="text-brand-orange text-[10px] sm:text-xs font-bold uppercase tracking-widest">{category}</span>
      <h3 class="text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight mt-1 leading-tight group-hover:text-brand-orange transition-colors duration-300">{title}</h3>
    </div>
    
    <div class="flex flex-wrap gap-1.5 sm:gap-2">
      {tags.map((tag) => (
        <span class="bg-white/10 backdrop-blur-md px-2.5 sm:px-3.5 py-0.5 sm:py-1 rounded-full text-[10px] sm:text-xs font-medium text-white/90 border border-white/5">
          {tag}
        </span>
      ))}
    </div>
  </div>
</div>
