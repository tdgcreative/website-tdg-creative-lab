---
import { getLangFromUrl } from '../i18n/utils';

export interface ArticleMeta {
  publishedAt: string;
  updatedAt?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalPath?: string;
  alternateIdPath?: string;
  alternateEnPath?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  articleMeta?: ArticleMeta;
}

const { 
  title, 
  description, 
  ogImage = '/og-default.jpg', 
  canonicalPath = '', 
  alternateIdPath,
  alternateEnPath,
  noindex = false,
  ogType = 'website',
  articleMeta
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://www.thedigitalgrounds.com';

// Handle canonical URL
const cleanPath = canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const canonicalURL = new URL(
  lang === 'en' && !cleanPath.startsWith('/en')
    ? `/en${cleanPath === '/' ? '' : cleanPath}`
    : cleanPath,
  siteUrl
);

const idPathResolved = alternateIdPath || (cleanPath.startsWith('/en') ? (cleanPath.replace(/^\/en/, '') || '/') : cleanPath);
const enPathResolved = alternateEnPath || (idPathResolved === '/' ? '/en' : `/en${idPathResolved}`);

const idAlternateURL = new URL(idPathResolved, siteUrl);
const enAlternateURL = new URL(enPathResolved, siteUrl);

// Structured data for local SEO in Surabaya
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "The Digital Grounds",
  "image": `${siteUrl}/TDG LOGO TRANSPARENT.png`,
  "url": siteUrl,
  "telephone": "+62-813-8238-837",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Surabaya",
    "addressRegion": "Jawa Timur",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "-7.257487",
    "longitude": "112.752090"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday"
    ],
    "opens": "09:00",
    "closes": "18:00"
  },
  "sameAs": [
    "https://instagram.com/tdg.creative.lab"
  ]
};

const articleStructuredData = articleMeta ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": [new URL(ogImage, siteUrl).toString()],
  "datePublished": articleMeta.publishedAt,
  "dateModified": articleMeta.updatedAt || articleMeta.publishedAt,
  "inLanguage": lang === 'en' ? 'en-US' : 'id-ID',
  "author": {
    "@type": "Organization",
    "name": articleMeta.author || "The Digital Grounds",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Digital Grounds",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/TDG LOGO TRANSPARENT.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  },
  ...(articleMeta.section ? { "articleSection": articleMeta.section } : {}),
  ...(articleMeta.tags?.length ? { "keywords": articleMeta.tags.join(', ') } : {})
} : null;

const breadcrumbStructuredData = articleMeta ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": lang === 'en' ? "Home" : "Beranda",
      "item": new URL(lang === 'en' ? '/en' : '/', siteUrl).toString()
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Insights & Blog",
      "item": new URL(lang === 'en' ? '/en/blog' : '/blog', siteUrl).toString()
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonicalURL.toString()
    }
  ]
} : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" href="/TDG LOGO TRANSPARENT.png" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical & Hreflang URLs -->
<link rel="canonical" href={canonicalURL} />
{!noindex && (
  <>
    <link rel="alternate" hreflang="id" href={idAlternateURL} />
    <link rel="alternate" hreflang="en" href={enAlternateURL} />
    <link rel="alternate" hreflang="x-default" href={idAlternateURL} />
  </>
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Robots Indexing Control -->
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow" />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, siteUrl)} />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'id_ID'} />

{articleMeta && (
  <>
    <meta property="article:published_time" content={articleMeta.publishedAt} />
    {articleMeta.updatedAt && <meta property="article:modified_time" content={articleMeta.updatedAt} />}
    {articleMeta.section && <meta property="article:section" content={articleMeta.section} />}
  </>
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(ogImage, siteUrl)} />

<!-- Local Business Structured Data (JSON-LD) -->
{!noindex && (
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
)}

{!noindex && articleStructuredData && (
  <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />
)}

{!noindex && breadcrumbStructuredData && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
)}
